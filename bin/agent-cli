#!/usr/bin/env -S python3 -I
"""agent-cli: one place for the questions agents keep asking about this repo.

Terse, one fact per line; --json on every subcommand. Stdlib only (Python 3.9+).
Built from a tally of the repo's agent transcripts: each subcommand replaces a lookup or
command sequence that agents repeated across sessions. Run `agent-cli <cmd> --help`.
"""
import argparse
import json
import os
import plistlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
IS_MAC = sys.platform == "darwin"
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07")
GH_TS = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?Z ")
ERR_LINE = re.compile(
    r"##\[error\]|^\s*error(\[E\d+\])?:|panicked at|^test \S+ \.\.\. FAILED|test result: FAILED|^failures:$"
    r"|error: could not compile|\bFAILED\b|^\s*Error:|^fatal:|BUILD FAILED|error: process didn't exit"
    r"|^\s*\S+\.(swift|rs|ps1|sh):\d+(:\d+)?: error|Assertion failed|Process completed with exit code [1-9]"
)
WARN_LINE = re.compile(r"^\s*warning(\[\w+\])?:|##\[warning\]|: warning:")
OFFLINE = False


class CliError(Exception):
    pass


# ---------------------------------------------------------------- helpers

def run(cmd, cwd=None, timeout=30, env=None):
    """Run a command; return (rc, stdout+stderr text). Never raises for a missing tool or timeout."""
    try:
        p = subprocess.run(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=timeout, text=True, errors="replace")
        return p.returncode, p.stdout
    except FileNotFoundError:
        return 127, f"{cmd[0]}: not found"
    except subprocess.TimeoutExpired as e:
        out = e.stdout if isinstance(e.stdout, str) else (e.stdout or b"").decode("utf-8", "replace")
        return 124, out + f"\n(timeout after {timeout}s)"


def out_of(cmd, cwd=None, timeout=30):
    rc, out = run(cmd, cwd=cwd, timeout=timeout)
    return out.strip() if rc == 0 else None


def strip_ansi(s):
    return ANSI.sub("", s)


def repo_root():
    r = out_of(["git", "rev-parse", "--show-toplevel"], cwd=os.getcwd())
    if r:
        return Path(r)
    return Path(__file__).resolve().parent.parent


ROOT = repo_root()


def git(*args, timeout=30):
    return out_of(["git", "-C", str(ROOT), *args], timeout=timeout)


def main_root():
    """The main checkout (the parent of the shared .git), even from a linked worktree."""
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if common:
        p = Path(common)
        return p.parent if p.name == ".git" else p
    return ROOT


def project_slug():
    return re.sub(r"[^A-Za-z0-9]", "-", str(main_root()))


def gh_ok():
    return not OFFLINE and shutil.which("gh") is not None


def gh_json(args, timeout=40):
    if not gh_ok():
        return None, "offline" if OFFLINE else "gh not installed"
    rc, out = run(["gh", *args], cwd=str(ROOT), timeout=timeout)
    if rc != 0:
        return None, out.strip().splitlines()[-1][:200] if out.strip() else f"gh exit {rc}"
    try:
        return json.loads(out), None
    except ValueError:
        return None, "gh returned non-JSON"


def repo_slug():
    url = git("remote", "get-url", "origin") or ""
    m = re.search(r"github\.com[:/]([^/]+/[^/.]+)", url)
    return m.group(1) if m else None


def human_bytes(n):
    if n is None:
        return "?"
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit in ("B", "K") else f"{n:.1f}{unit}"
        n /= 1024.0
    return str(n)


_DU_CACHE = Path(tempfile.gettempdir()) / "agent-cli-du.json"
FRESH = False


def du_bytes(path, ttl=600, timeout=60):
    """Directory size in bytes via `du -sk`, cached for `ttl` seconds (None if missing/unknown)."""
    path = Path(path)
    if not path.exists() or path.is_symlink():
        return None
    key = str(path)
    cache = {}
    try:
        cache = json.loads(_DU_CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    hit = cache.get(key)
    if hit and not FRESH and time.time() - hit[0] < ttl:
        return hit[1]
    if shutil.which("du") is None:
        return None
    rc, out = run(["du", "-sk", key], timeout=timeout)
    try:
        size = int(out.split()[0]) * 1024
    except (ValueError, IndexError):
        return None
    cache[key] = [time.time(), size]
    try:
        _DU_CACHE.write_text(json.dumps(cache))
    except OSError:
        pass
    return size


def disk_free(path="/"):
    try:
        u = shutil.disk_usage(path)
        return {"free": u.free, "total": u.total, "free_h": human_bytes(u.free), "used_pct": round(100 * u.used / u.total)}
    except OSError:
        return None


def shared_target():
    env = os.environ.get("CARGO_TARGET_DIR")
    return Path(env) if env else HOME / "Library" / "Caches" / "Trek" / "target.nosync"


def ps_lines():
    if os.name == "nt":
        return []
    rc, out = run(["ps", "-axo", "pid=,etime=,command="], timeout=10)
    return out.splitlines() if rc == 0 else []


def trek_processes():
    """The installed Trek (/Applications/...Trek.app) and dev builds (target*/trek) by pid."""
    found = []
    for line in ps_lines():
        parts = line.strip().split(None, 2)
        if len(parts) < 3:
            continue
        pid, etime, cmd = parts
        exe = cmd.split(" --")[0]
        if re.search(r"/Trek\.app/Contents/MacOS/trek$", exe):
            app = exe.split("/Contents/MacOS/")[0]
            found.append({"pid": int(pid), "kind": "app", "path": app, "version": app_version(app), "uptime": etime})
        elif re.search(r"/target[^ ]*/(debug|release)/trek$", exe):
            found.append({"pid": int(pid), "kind": "dev", "path": exe, "uptime": etime})
    return found


def app_version(app):
    try:
        with open(Path(app) / "Contents" / "Info.plist", "rb") as f:
            return plistlib.load(f).get("CFBundleShortVersionString")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return None


def cargo_running():
    """(top-level cargo/xcodebuild commands, number of rustc processes) running now."""
    tops, rustc = [], 0
    for l in ps_lines():
        cmd = (l.strip().split(None, 2) + ["", "", ""])[2]
        exe = os.path.basename(cmd.split(" ")[0])
        if exe == "rustc":
            rustc += 1
        elif exe in ("cargo", "xcodebuild"):
            tops.append(exe + " " + cmd.split(" ", 1)[1][:110] if " " in cmd else exe)
    return tops, rustc


def workspace_version():
    try:
        m = re.search(r'^\[workspace\.package\][^\[]*?^version\s*=\s*"([^"]+)"', (ROOT / "Cargo.toml").read_text(), re.M | re.S)
        if m:
            return m.group(1)
        m = re.search(r'^version\s*=\s*"([^"]+)"', (ROOT / "Cargo.toml").read_text(), re.M)
        return m.group(1) if m else None
    except OSError:
        return None


def latest_tag():
    tags = git("tag", "--list", "v*", "--sort=-v:refname")
    return tags.splitlines()[0] if tags else None


def next_patch(tag):
    m = re.match(r"v?(\d+)\.(\d+)\.(\d+)", tag or "")
    return f"{m.group(1)}.{m.group(2)}.{int(m.group(3)) + 1}" if m else None


def recent_runs(limit=30):
    data, err = gh_json(["run", "list", "--limit", str(limit), "--json",
                         "databaseId,workflowName,status,conclusion,headBranch,headSha,createdAt,displayTitle,event"])
    return (data or []), err


def run_brief(r):
    if not r:
        return None
    return {"id": r.get("databaseId"), "workflow": r.get("workflowName"), "status": r.get("status"),
            "conclusion": r.get("conclusion") or "-", "branch": r.get("headBranch"),
            "sha": (r.get("headSha") or "")[:7], "created": r.get("createdAt"), "title": (r.get("displayTitle") or "")[:70]}


def ago(ts):
    secs = time.time() - ts
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= n:
            return f"{int(secs // n)}{unit}"
    return f"{int(secs)}s"


def tail_bytes(path, n=65536):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - n))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def extract_errors(text, cap=30):
    """Error lines from a CI/cargo/xcodebuild log, ANSI and GitHub timestamps stripped, deduped."""
    lines = [GH_TS.sub("", strip_ansi(l)).rstrip() for l in text.splitlines()]
    hits, seen = [], set()
    for i, l in enumerate(lines):
        if not ERR_LINE.search(l) or "##[group]" in l:
            continue
        if re.search(r"^\s*(Compiling|Running|Finished)\b|FAILED: 0|0 failed", l):
            continue
        item = l.strip()[:240]
        nxt = lines[i + 1].strip() if i + 1 < len(lines) else ""
        if nxt.startswith("-->") or ("panicked at" in l and nxt):
            item += "  " + nxt[:160]
        if item not in seen:
            seen.add(item)
            hits.append(item)
        if len(hits) >= cap:
            break
    return hits


# ---------------------------------------------------------------- subcommands

def cmd_status(a):
    """Branch, HEAD, dirty files, main vs origin/main, tag, CI/release, running Trek, disk."""
    d = {"root": str(ROOT), "branch": git("branch", "--show-current") or "(detached)"}
    head = git("log", "-1", "--format=%h %s")
    d["head"] = head
    porcelain = git("status", "--porcelain") or ""
    files = [l for l in porcelain.splitlines() if l.strip()]
    d["dirty"] = len(files)
    d["dirty_files"] = [l[:3].strip() + " " + l[3:] for l in files[:15]]
    if a.fetch:
        run(["git", "-C", str(ROOT), "fetch", "-q", "origin"], timeout=60)
    ab = git("rev-list", "--left-right", "--count", "HEAD...origin/main")
    if ab:
        ahead, behind = ab.split()
        d["vs_origin_main"] = f"ahead {ahead} behind {behind}"
    mo = git("rev-list", "--left-right", "--count", "main...origin/main")
    if mo:
        ahead, behind = mo.split()
        d["main_vs_origin_main"] = f"ahead {ahead} behind {behind}"
    fetch_head = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir") or ".") / "FETCH_HEAD"
    if fetch_head.exists():
        d["last_fetch"] = ago(fetch_head.stat().st_mtime) + " ago"
    d["latest_tag"] = latest_tag()
    d["workspace_version"] = workspace_version()
    runs, err = recent_runs(30)
    if err:
        d["ci"] = d["release_run"] = f"unknown ({err})"
    else:
        ci = next((r for r in runs if r.get("workflowName") == "CI" and r.get("headBranch") == "main"), None)
        rel = next((r for r in runs if r.get("workflowName") == "Release"), None)
        d["ci_main"] = run_brief(ci)
        d["release_run"] = run_brief(rel)
        mine = next((r for r in runs if r.get("workflowName") == "CI" and r.get("headBranch") == d["branch"]), None)
        if mine:
            d["ci_branch"] = run_brief(mine)
    procs = trek_processes()
    app = [p for p in procs if p["kind"] == "app"]
    d["trek"] = (f"pid {app[0]['pid']} v{app[0]['version']} up {app[0]['uptime']}" if app else "not running")
    d["trek_dev_builds_running"] = len([p for p in procs if p["kind"] == "dev"])
    installed = app_version("/Applications/Trek.app")
    if installed:
        d["trek_installed"] = installed
    df = disk_free("/")
    d["disk_free"] = f"{df['free_h']} ({df['used_pct']}% used)" if df else "?"
    d["shared_build_cache"] = human_bytes(du_bytes(shared_target()))
    return d


def cmd_ci(a):
    """Jobs of a GitHub Actions run with conclusions; failed jobs' error lines from the job log."""
    if not gh_ok():
        return {"run": a.run, "error": "offline" if OFFLINE else "gh not installed"}
    run_id = a.run
    if run_id == "latest":
        args = ["run", "list", "--limit", "1", "--json", "databaseId"]
        if a.workflow:
            args += ["--workflow", a.workflow]
        if a.branch:
            args += ["--branch", a.branch]
        data, err = gh_json(args)
        if err or not data:
            raise CliError(f"no run found ({err or 'empty'})")
        run_id = str(data[0]["databaseId"])
    data, err = gh_json(["run", "view", run_id, "--json",
                         "databaseId,workflowName,status,conclusion,headBranch,headSha,event,createdAt,updatedAt,url,displayTitle,jobs"])
    if err:
        raise CliError(f"gh run view {run_id}: {err}")
    d = {"run": data.get("databaseId"), "workflow": data.get("workflowName"), "status": data.get("status"),
         "conclusion": data.get("conclusion") or "-", "branch": data.get("headBranch"),
         "sha": (data.get("headSha") or "")[:7], "title": (data.get("displayTitle") or "")[:80], "url": data.get("url")}
    slug = repo_slug()
    jobs = []
    for j in data.get("jobs") or []:
        conc = j.get("conclusion") or "-"
        job = {"name": j.get("name"), "status": j.get("status"), "conclusion": conc, "id": j.get("databaseId")}
        failed_steps = [s.get("name") for s in j.get("steps") or [] if s.get("conclusion") == "failure"]
        if failed_steps:
            job["failed_steps"] = failed_steps
        if conc in ("failure", "timed_out") or failed_steps:
            if slug and j.get("databaseId") and j.get("status") == "completed":
                api = ["gh", "api", f"repos/{slug}/actions/jobs/{j['databaseId']}/logs"]
                rc, log = run(api[:2] + ["--allow-escape-sequences"] + api[2:], cwd=str(ROOT), timeout=120)
                if rc != 0 and "unknown flag" in log:  # older gh: logs come back without the escape guard
                    rc, log = run(api, cwd=str(ROOT), timeout=120)
                job["errors"] = extract_errors(log, a.max) if rc == 0 else [f"log unavailable: {log.strip()[-160:]}"]
        jobs.append(job)
    d["counts"] = {k: sum(1 for j in jobs if j["conclusion"] == k) for k in sorted({j["conclusion"] for j in jobs})}
    # successes are only counted unless asked for: the jobs that need a look come first and alone
    d["jobs"] = jobs if a.all_jobs else [j for j in jobs if j["conclusion"] not in ("success", "skipped")]
    return d


def crate_purpose(cdir):
    for f in ("src/lib.rs", "src/main.rs"):
        p = cdir / f
        if not p.exists():
            continue
        doc = []
        try:
            with open(p, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    s = line.strip()
                    if s.startswith("//!"):
                        t = s[3:].strip()
                        if not t and doc:
                            break
                        if t.startswith("#") and not doc:
                            continue
                        if t:
                            doc.append(t)
                    elif doc or (s and not s.startswith("#![")):
                        break
        except OSError:
            continue
        text = " ".join(doc)
        m = re.match(r"(.+?[.!?])(\s|$)", text)
        text = m.group(1) if m else text
        return (text[:97] + "...") if len(text) > 100 else text, f
    return "", None


def cmd_crates(a):
    """Workspace crates with the first sentence of their lib.rs/main.rs doc comment."""
    rows = []
    for cdir in sorted((ROOT / "crates").iterdir()):
        if not (cdir / "Cargo.toml").exists():
            continue
        purpose, src = crate_purpose(cdir)
        rows.append({"crate": cdir.name, "purpose": purpose, "src": src})
    return {"count": len(rows), "crates": rows, "_text": [f"{r['crate']}: {r['purpose']}" for r in rows]}


FEATURES = ROOT / ".agents" / "skills" / "verify-trek" / "references" / "features"


def cmd_feature(a):
    """A verify-trek feature doc: its summary and the ids it lists (mocks, routes, controls, code)."""
    files = sorted(p for p in FEATURES.glob("*.md") if p.name != "README.md")
    readme = (FEATURES / "README.md").read_text() if (FEATURES / "README.md").exists() else ""
    summaries = {m.group(2): m.group(3).strip() for m in re.finditer(r"- \[([^\]]+)\]\(([^)]+)\) — (.+)", readme)}
    if not a.name:
        rows = [{"feature": p.stem, "summary": summaries.get(p.name, "")[:140]} for p in files]
        return {"features": rows, "_text": [f"{r['feature']}: {r['summary']}" for r in rows]}
    q = a.name.lower()
    match = [p for p in files if p.stem == q] or [p for p in files if q in p.stem] or \
            [p for p in files if q in p.read_text(errors="replace").lower()[:4000]]
    if not match:
        raise CliError(f"no feature matches {a.name!r}; run `agent-cli feature` for the list")
    p = match[0]
    text = p.read_text(errors="replace")
    ids = {
        "mocks": sorted(set(re.findall(r"\bmock:[a-z][\w-]*", text))),
        "routes": sorted(set(re.findall(r"\b(?:settings|tool|thread|project|title):[a-z][\w-]*", text))),
        "trek_dev": sorted(set(m.strip() for m in re.findall(r"trek-dev ((?:open|send|control|project|screenshot|logs|start)[^\n#`]*)", text)))[:25],
        "code": sorted(set(re.findall(r"\b(?:crates|ios|script|docs)/[\w./-]+\.\w+", text)))[:40],
        "settings_keys": sorted(k for k in set(re.findall(r"`((?:[a-z_]+\.){1,3}[a-z_]+)`", text))
                                if not re.search(r"\.(rs|md|swift|toml|sh|ps1|py|json|js|html|plist|yml)$", k))[:20],
    }
    d = {"feature": p.stem, "path": str(p.relative_to(ROOT)), "summary": summaries.get(p.name, ""),
         "other_matches": [m.stem for m in match[1:6]], **ids}
    if a.full:
        d["text"] = text
    return d


def cmd_where(a):
    """Search crates/ (and with --all ios/, script/, docs/, .agents/) for text or a symbol; file:line."""
    pattern = a.query
    regex = a.regex
    if a.defs:
        name = re.escape(a.query)
        pattern = (rf"\b(fn|struct|enum|trait|type|const|static|mod|union|macro_rules!|class|func|protocol|extension|var|let)\s+{name}\b"
                   rf"|\bimpl\b[^{{;]*\b{name}\b")
        regex = True
    dirs = ["crates"] + (["ios", "script", "docs", ".agents", ".github"] if a.all else [])
    dirs = [x for x in dirs if (ROOT / x).exists()]
    if shutil.which("rg"):
        cmd = ["rg", "-n", "--no-heading", "--color", "never", "-M", "220", "-g", "!target*", "-g", "!*.lock"]
        cmd += [] if regex else ["-F"]
        cmd += ["-S"] if not a.case else []
        cmd += ["-e", pattern, *dirs]
    else:
        cmd = ["grep", "-rnI", "--exclude-dir=target*"] + ([] if regex else ["-F"]) + ([] if a.case else ["-i"])
        cmd += (["-E"] if regex else []) + ["-e", pattern, *dirs]
    rc, out = run(cmd, cwd=str(ROOT), timeout=60)
    if rc not in (0, 1):
        raise CliError(out.strip()[-200:])
    hits = [l for l in out.splitlines() if l.strip()]
    shown = []
    for l in hits[: a.max]:
        m = re.match(r"([^:]+):(\d+):(.*)", l)
        if m:
            shown.append({"file": m.group(1), "line": int(m.group(2)), "text": m.group(3).strip()[:160]})
    files = sorted({h["file"] for h in shown})
    return {"query": a.query, "total": len(hits), "shown": len(shown), "files": len(set(re.match(r"[^:]+", l).group(0) for l in hits)),
            "hits": shown, "_text": [f"{h['file']}:{h['line']}: {h['text']}" for h in shown] +
            ([f"... {len(hits) - len(shown)} more (--max)"] if len(hits) > len(shown) else []) +
            ([] if hits else ["no hits"])}


LOG_DIR = HOME / "Library" / "Logs" / "Trek"
LEVEL = re.compile(r"^\S+\s+(TRACE|DEBUG|INFO|WARN|ERROR)\s")
# The freeze watch's WARN when the main thread stops (crates/trek-logging/src/freeze.rs).
FREEZE = "freeze: the main thread has made no progress"


def cmd_logs(a):
    """Newest ~/Library/Logs/Trek log: warnings/errors/panics/freezes first, then the tail. ANSI stripped."""
    logs = sorted(LOG_DIR.glob("*.log"), key=lambda p: p.stat().st_mtime) if LOG_DIR.exists() else []
    if not logs:
        return {"log": None, "note": f"no logs in {LOG_DIR}"}
    p = logs[-1]
    text = strip_ansi(tail_bytes(p, 4 * 1024 * 1024))
    lines = text.splitlines()[1:] if len(text) >= 4 * 1024 * 1024 else text.splitlines()
    if a.grep:
        lines = [l for l in lines if a.grep.lower() in l.lower()]
    bad = [l for l in lines if (LEVEL.match(l) and LEVEL.match(l).group(1) in ("WARN", "ERROR")) or "panicked" in l]
    cut = lambda l: l[:a.width]
    d = {"log": str(p), "size": human_bytes(p.stat().st_size), "lines": len(lines),
         "warn": sum(1 for l in bad if " WARN " in l[:40]), "error": sum(1 for l in bad if " ERROR " in l[:40]),
         "panics": sum(1 for l in bad if "panicked" in l or "panic on thread" in l),
         "freezes": sum(1 for l in bad if FREEZE in l),
         "problems": [cut(l) for l in bad[-a.n:]], "tail": [cut(l) for l in lines[-a.n:]]}
    crash = sorted((HOME / "Library" / "Logs" / "DiagnosticReports").glob("trek*.ips"), key=lambda x: x.stat().st_mtime) \
        if IS_MAC and (HOME / "Library" / "Logs" / "DiagnosticReports").exists() else []
    if crash:
        d["latest_crash_report"] = f"{crash[-1]} ({ago(crash[-1].stat().st_mtime)} ago)"
    # The freeze watch's stacks files (crates/trek-logging/src/freeze.rs), newest last.
    freezes = sorted(LOG_DIR.glob("freeze-*.txt"))[-3:]
    d["freeze_files"] = [f"{f} ({ago(f.stat().st_mtime)} ago)" for f in freezes]
    d["_text"] = [f"log {d['log']} {d['size']} warn={d['warn']} error={d['error']} panics={d['panics']} freezes={d['freezes']}"] + \
        ([f"crash {d['latest_crash_report']}"] if crash else []) + \
        [f"freeze {f}" for f in d["freeze_files"]] + \
        ["-- problems (newest last)"] + d["problems"] + ["-- tail"] + d["tail"]
    return d


def worktree_list():
    out = git("worktree", "list", "--porcelain") or ""
    wts, cur = [], {}
    for line in out.splitlines() + [""]:
        if not line.strip():
            if cur:
                wts.append(cur)
            cur = {}
            continue
        k, _, v = line.partition(" ")
        cur[k] = v or True
    return wts


def cmd_worktrees(a):
    """git worktrees: branch, merged into main?, commits ahead, dirty count, own target dir size."""
    base = "main" if git("rev-parse", "--verify", "-q", "main") else "origin/main"
    rows = []
    for w in worktree_list():
        path = w.get("worktree")
        br = w.get("branch", "")
        br = br.replace("refs/heads/", "") if isinstance(br, str) else ""
        row = {"path": path, "branch": br or "(detached)", "head": str(w.get("HEAD", ""))[:7]}
        ref = br or row["head"]
        if ref and br != "main":
            rc, _ = run(["git", "-C", str(ROOT), "merge-base", "--is-ancestor", ref, base], timeout=20)
            row["merged"] = rc == 0
            ahead = git("rev-list", "--count", f"{base}..{ref}")
            row["ahead"] = int(ahead) if ahead and ahead.isdigit() else None
        last = git("log", "-1", "--format=%cr", ref) if ref else None
        row["last_commit"] = last
        if path and Path(path).exists() and not a.fast:
            st = out_of(["git", "-C", path, "status", "--porcelain"], timeout=20)
            row["dirty"] = len([l for l in (st or "").splitlines() if l.strip()])
            for t in ("target", "target.nosync"):
                tp = Path(path) / t
                if tp.exists() and not tp.is_symlink():
                    row["target"] = human_bytes(du_bytes(tp))
        elif path and not Path(path).exists():
            row["missing"] = True
        rows.append(row)
    merged = [r for r in rows if r.get("merged") and not r.get("dirty")]
    return {"base": base, "count": len(rows), "merged_clean": len(merged), "worktrees": rows,
            # only agent worktrees: others (phone-update's src, Trek's own) belong to tools
            "removable": [f"git worktree remove {r['path']}" for r in merged
                          if r["path"] != str(ROOT) and "/.claude/worktrees/" in r["path"]][:20]}


def cmd_disk(a):
    """Disk free, the build caches' sizes, and the two safe levers this repo uses."""
    mr = main_root()
    st = shared_target()
    paths = {
        "main target.nosync": mr / "target.nosync",
        "main target": mr / "target",
        "shared cache": st,
        "shared debug": st / "debug",
        "shared debug/incremental": st / "debug" / "incremental",
        "shared shots": st / "shots",
    }
    if st.exists():
        for sub in sorted(st.iterdir()):
            if sub.is_dir() and sub.name not in ("debug", "shots", "tmp"):
                paths[f"shared {sub.name}"] = sub
    sizes = {}
    for k, p in paths.items():
        b = du_bytes(p)
        if b is not None:
            sizes[k] = human_bytes(b)
    wt_targets = {}
    for w in worktree_list():
        p = w.get("worktree")
        if p and p != str(mr):
            for t in ("target", "target.nosync"):
                tp = Path(p) / t
                if tp.exists() and not tp.is_symlink():
                    wt_targets[Path(p).name] = human_bytes(du_bytes(tp))
    inc = st / "debug" / "incremental"
    stale = 0
    if inc.exists():
        cutoff = time.time() - 15 * 60
        stale = sum(1 for x in inc.iterdir() if x.is_dir() and x.stat().st_mtime < cutoff)
    builds, rustc = cargo_running()
    df = disk_free("/")
    sweep = HOME / ".claude" / "bin" / "sweep-builds.sh"
    levers = [
        f"{'~/.claude/bin/sweep-builds.sh' if sweep.exists() else '(sweep-builds.sh missing)'}  # cargo sweep, caps targets at 40G; refuses while cargo/rustc run",
        f"find {inc} -mindepth 1 -maxdepth 1 -type d -mmin +15 -exec rm -rf {{}} +  # stale incremental dirs; safe while builds run",
        "export CARGO_INCREMENTAL=0  # before several worktree builds at once",
    ]
    d = {"disk_free": df["free_h"] if df else "?", "used_pct": df["used_pct"] if df else None, "sizes": sizes,
         "worktree_targets": wt_targets, "stale_incremental_dirs": stale, "builds_running": len(builds), "rustc_running": rustc,
         "sweep_log": str(HOME / "Library" / "Logs" / "trek-sweep-builds.log"), "levers": levers}
    if builds:
        d["builds"] = builds[:5]
    return d


def cmd_merge(a):
    """Merge a pull request only when CI passed on its head and, when it touches app code, the live checks (Live, all three platforms) did too (script/merge-pr)."""
    args = [str(a.number)] + (["--dry-run"] if a.dry_run else []) + (["--", *a.merge_args] if a.merge_args else [])
    if OFFLINE:
        return {"pr": a.number, "offline": True, "_text": [f"offline: would run script/merge-pr {' '.join(args)}"]}
    p = subprocess.run([sys.executable, str(ROOT / "script" / "merge-pr"), *args], cwd=str(ROOT),
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    lines = [l for l in p.stdout.splitlines() if l.strip()]
    if p.returncode != 0:
        raise CliError("\n".join(lines) or f"script/merge-pr exited {p.returncode}")
    return {"pr": a.number, "merged": not a.dry_run, "dry_run": a.dry_run, "_text": lines}


def cmd_release(a):
    """Latest tag, release run state, in-progress guard, and the exact gh line for the next version."""
    tag = latest_tag()
    d = {"latest_tag": tag, "workspace_version": workspace_version()}
    rels, err = gh_json(["release", "list", "--limit", "1", "--json", "tagName,publishedAt,isPrerelease"]) if gh_ok() else (None, "offline")
    if rels:
        d["latest_github_release"] = rels[0].get("tagName")
        d["published"] = rels[0].get("publishedAt")
        tag = max([tag or "v0.0.0", rels[0].get("tagName") or "v0.0.0"], key=lambda t: [int(x) for x in re.findall(r"\d+", t)[:3]])
    runs, err = gh_json(["run", "list", "--workflow", "release.yml", "--limit", "3", "--json",
                         "databaseId,status,conclusion,headBranch,createdAt,displayTitle,event"]) if gh_ok() else (None, "offline")
    if err:
        d["release_runs"] = f"unknown ({err})"
    else:
        d["release_runs"] = [{"id": r["databaseId"], "status": r["status"], "conclusion": r.get("conclusion") or "-",
                              "created": r["createdAt"]} for r in runs]
        d["in_progress"] = any(r["status"] != "completed" for r in runs)
    nxt = next_patch(tag)
    d["next_version"] = nxt
    d["command"] = f"gh workflow run release.yml --ref main -f version={nxt} -f channel=stable -F notes=@notes.md"
    d["watch"] = "gh run list --workflow release.yml --limit 1  # then: agent-cli ci <id>"
    ab = git("rev-list", "--left-right", "--count", "main...origin/main")
    if ab:
        d["main_vs_origin_main"] = "ahead {} behind {}".format(*ab.split())
    d["rules"] = ["never run script/release.sh locally", "no push to main while a stable release runs (it pushes its bump)",
                  "check origin/main for the Windows agent's commits first", "~45 min; git pull main after"]
    if d.get("in_progress"):
        d["rules"].insert(0, "RELEASE IN PROGRESS: do not push or dispatch")
    return d


POSTHOG_KEY_FILE = HOME / ".trek-bench" / "posthog-personal.key"
POSTHOG_PROJECT_FILE = HOME / ".trek-bench" / "posthog-project"


def asset_kind(name):
    """(kind, platform) of a release asset: installers people download, archives the updater
    fetches, the channel manifest every update check reads; signatures and symbols (.dSYM.zip,
    .pdb.zip: for `symbolicate`, not a download) are (None, None)."""
    if name.endswith(".minisig") or name.endswith(".sig"):
        return None, None
    if re.search(r"\.(dSYM|pdb|debug)\.(zip|tar\.gz|tar\.xz)$", name):
        return None, None
    if re.fullmatch(r"(stable|beta|nightly)\.json", name):
        return "manifest", None
    platform = ("mac-arm64" if "darwin-aarch64" in name else "mac-intel" if "darwin-x86_64" in name
                else "windows-x64" if ("windows" in name or name.endswith(".exe")) else "other")
    if name.endswith(".dmg") or name.endswith(".exe") or name.endswith(".msi"):
        return "installer", platform
    if name.endswith(".tar.gz") or name.endswith(".zip"):
        return "update", platform
    return "other", platform


def posthog_installs(timeout=30):
    """Unique and active installs from PostHog's query API, with the personal key in
    ~/.trek-bench/posthog-personal.key. None (and why) without one."""
    if not POSTHOG_KEY_FILE.exists():
        return None, f"no PostHog personal key in {POSTHOG_KEY_FILE}"
    if OFFLINE:
        return None, "offline"
    import urllib.request
    import urllib.error
    key = POSTHOG_KEY_FILE.read_text().strip()
    ingest = os.environ.get("TREK_POSTHOG_HOST") or "https://us.i.posthog.com"
    host = os.environ.get("TREK_POSTHOG_APP_HOST") or ingest.replace(".i.posthog.com", ".posthog.com")
    project = (os.environ.get("TREK_POSTHOG_PROJECT")
               or (POSTHOG_PROJECT_FILE.read_text().strip() if POSTHOG_PROJECT_FILE.exists() else "@current"))
    def query(hogql):
        body = json.dumps({"query": {"kind": "HogQLQuery", "query": hogql}}).encode()
        req = urllib.request.Request(f"{host.rstrip('/')}/api/projects/{project}/query/", data=body, method="POST",
                                     headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode()).get("results") or []
    try:
        row = (query("SELECT uniq(distinct_id), uniqIf(distinct_id, timestamp > now() - INTERVAL 7 DAY), "
                     "uniqIf(distinct_id, timestamp > now() - INTERVAL 30 DAY), countIf(event = 'install') "
                     "FROM events WHERE event IN ('install', 'app_opened')") or [[0, 0, 0, 0]])[0]
        by_os = query("SELECT properties.$os, uniq(distinct_id) FROM events WHERE event IN ('install', 'app_opened') "
                      "AND timestamp > now() - INTERVAL 30 DAY GROUP BY 1 ORDER BY 2 DESC")
    except urllib.error.HTTPError as e:
        return None, f"PostHog answered {e.code} ({host}, project {project})"
    except (urllib.error.URLError, OSError, ValueError) as e:
        return None, f"PostHog: {e}"
    return {"host": host, "project": project, "installs_seen": row[0], "active_7d": row[1], "active_30d": row[2],
            "install_events": row[3], "active_30d_by_os": {str(o or "?"): n for o, n in by_os}}, None


def cmd_downloads(a):
    """Release downloads per version and platform from GitHub, totals, and PostHog installs if a key is there."""
    slug = a.repo
    d = {"repo": slug}
    if not gh_ok():
        d["github"] = "offline" if OFFLINE else "gh not installed"
        releases = []
    else:
        rc, out = run(["gh", "api", "--paginate", f"repos/{slug}/releases?per_page=100", "--jq",
                       ".[] | {tag: .tag_name, published: .published_at, pre: .prerelease, draft: .draft, "
                       "assets: [.assets[] | {name, n: .download_count}]}"], cwd=str(ROOT), timeout=a.timeout)
        releases = []
        if rc != 0:
            d["github"] = out.strip().splitlines()[-1][:200] if out.strip() else f"gh exit {rc}"
        else:
            for line in out.splitlines():
                try:
                    releases.append(json.loads(line))
                except ValueError:
                    pass
    totals = {"installer": {}, "update": {}, "other": {}}
    manifest_total = 0
    versions = []
    for rel in releases:
        if rel.get("draft"):
            continue
        row = {"tag": rel["tag"], "published": (rel.get("published") or "")[:10], "installers": {}, "updates": {},
               "manifest_reads": 0}
        if rel.get("pre"):
            row["prerelease"] = True
        for asset in rel.get("assets", []):
            kind, platform = asset_kind(asset["name"])
            if kind is None:
                continue
            if kind == "manifest":
                row["manifest_reads"] += asset["n"]
                manifest_total += asset["n"]
                continue
            bucket = row["installers"] if kind == "installer" else row["updates"] if kind == "update" else row.setdefault("other", {})
            bucket[platform] = bucket.get(platform, 0) + asset["n"]
            totals[kind][platform] = totals[kind].get(platform, 0) + asset["n"]
        versions.append(row)
    shown = versions if a.all else versions[:a.n]
    d["versions"] = shown
    d["totals"] = {"installers": totals["installer"], "installers_all": sum(totals["installer"].values()),
                   "updates": totals["update"], "updates_all": sum(totals["update"].values()),
                   "manifest_reads": manifest_total, "releases": len(versions)}
    ph, why = posthog_installs()
    d["posthog"] = ph if ph else why
    fmt = lambda b: " ".join(f"{k}={v}" for k, v in sorted(b.items())) or "-"
    text = [f"repo {slug} ({len(versions)} releases; installers = .dmg/.exe, updates = archives the updater fetched)"]
    for r in shown:
        text.append(f"{r['tag']:<22} {r['published']}  installers {fmt(r['installers'])}  updates {fmt(r['updates'])}"
                    f"  manifest {r['manifest_reads']}" + ("  (pre)" if r.get("prerelease") else ""))
    if len(versions) > len(shown):
        text.append(f"... {len(versions) - len(shown)} older (--all)")
    t = d["totals"]
    text.append(f"total installers {t['installers_all']} ({fmt(t['installers'])})")
    text.append(f"total updates {t['updates_all']} ({fmt(t['updates'])})  manifest reads {t['manifest_reads']}")
    if "github" in d:
        text.append(f"github {d['github']}")
    if ph:
        text.append(f"posthog installs seen {ph['installs_seen']}  active 7d {ph['active_7d']}  active 30d {ph['active_30d']}"
                    f"  install events {ph['install_events']}  30d by os {fmt(ph['active_30d_by_os'])}")
    else:
        text.append(f"posthog {why}")
    d["_text"] = text
    return d


def cmd_phone(a):
    """iPhone app update state via ios/scripts/phone-update.sh --status (changes nothing)."""
    script = ROOT / "ios" / "scripts" / "phone-update.sh"
    d = {"script": str(script.relative_to(ROOT)) if script.exists() else None}
    if not script.exists():
        d["note"] = "no ios/scripts/phone-update.sh"
        return d
    if OFFLINE:
        d["skipped"] = "offline"
        return d
    rc, out = run(["zsh", str(script), "--status"], cwd=str(ROOT), timeout=a.timeout)
    lines = [strip_ansi(l).rstrip() for l in out.splitlines() if l.strip()]
    d["exit"] = rc
    d["lines"] = lines[-40:]
    log = HOME / "Library" / "Logs" / "trek-phone-update.log"
    if log.exists():
        d["log"] = str(log)
        d["log_last"] = [l for l in tail_bytes(log, 4096).splitlines() if l.strip()][-3:]
    d["_text"] = [f"exit {rc}"] + lines[-40:] + ([f"log {log}"] + d.get("log_last", []) if log.exists() else [])
    return d


def memory_dir():
    return HOME / ".claude" / "projects" / project_slug() / "memory"


def cmd_memory(a):
    """Claude memory notes for this repo: name and description; with a query, the matching notes."""
    md = memory_dir()
    if not md.exists():
        return {"dir": str(md), "notes": [], "note": "no memory dir"}
    notes = []
    for p in sorted(md.glob("*.md")):
        if p.name == "MEMORY.md":
            continue
        t = p.read_text(errors="replace")
        m = re.search(r'^description:\s*"?(.*?)"?\s*$', t, re.M)
        notes.append({"note": p.stem, "description": (m.group(1) if m else "")[:160], "_body": t})
    if a.query:
        q = a.query.lower()
        hits = [n for n in notes if q in n["note"].lower() or q in n["_body"].lower()]
        d = {"dir": str(md), "query": a.query, "matches": [{"note": n["note"], "description": n["description"]} for n in hits]}
        if hits and not a.list:
            body = re.sub(r"^---\n.*?\n---\n", "", hits[0]["_body"], flags=re.S).strip()
            d["first"] = hits[0]["note"]
            d["body"] = body
            d["_text"] = [f"{n['note']}: {n['description']}" for n in hits] + [f"-- {hits[0]['note']}", body]
        return d
    rows = [{"note": n["note"], "description": n["description"]} for n in notes]
    return {"dir": str(md), "count": len(rows), "notes": rows, "_text": [f"{r['note']}: {r['description']}" for r in rows]}


def task_dirs():
    roots = []
    if hasattr(os, "getuid"):
        roots.append(Path(f"/private/tmp/claude-{os.getuid()}"))
        roots.append(Path(f"/tmp/claude-{os.getuid()}"))
    roots.append(Path(tempfile.gettempdir()) / f"claude-{os.getuid() if hasattr(os, 'getuid') else 'user'}")
    seen, out = set(), []
    for r in roots:
        base = r / project_slug()
        try:
            rp = base.resolve()
        except OSError:
            continue
        if rp in seen or not base.exists():
            continue
        seen.add(rp)
        out.extend(sorted(base.glob("*/tasks")))
    return out


def last_agent_text(path):
    tool = ""
    for line in reversed(tail_bytes(path, 262144).splitlines()):
        if '"assistant"' not in line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue
        for b in reversed((d.get("message") or {}).get("content") or []):
            if isinstance(b, dict) and b.get("type") == "text" and b.get("text", "").strip():
                return b["text"].strip().splitlines()[0][:160]
            if isinstance(b, dict) and b.get("type") == "tool_use" and not tool:
                tool = f"[tool {b.get('name')}]"
    return tool


def cmd_tasks(a):
    """Newest background task outputs and sub-agent transcripts of this repo's sessions, with their last line."""
    items = []
    for td in task_dirs():
        for p in td.glob("*.output"):
            try:
                st = p.stat()
            except OSError:
                continue
            items.append((st.st_mtime, st.st_size, p))
    items.sort(reverse=True)
    rows = []
    for mt, size, p in items[: a.n]:
        agent = p.is_symlink() or str(os.path.realpath(p)).endswith(".jsonl")
        if agent:
            last = last_agent_text(os.path.realpath(p))
        else:
            tail = [l for l in strip_ansi(tail_bytes(p, 8192)).splitlines() if l.strip()]
            last = tail[-1][:160] if tail else ""
        rows.append({"id": p.stem, "kind": "agent" if agent else "bash", "age": ago(mt), "size": human_bytes(size),
                     "session": p.parent.parent.name[:8], "last": last, "path": str(p)})
    return {"count": len(items), "shown": len(rows), "tasks": rows,
            "_text": [f"{r['id']} {r['kind']} {r['age']} {r['size']} s={r['session']} | {r['last']}" for r in rows]}


def digest_text(text, cap=25):
    text = strip_ansi(text)
    lines = [GH_TS.sub("", l).rstrip() for l in text.splitlines()]
    results = [l.strip() for l in lines if l.strip().startswith("test result:")]
    failed_tests = sorted({m.group(1) for l in lines for m in [re.match(r"^test (\S+) \.\.\. FAILED", l.strip())] if m})
    warnings = [l for l in lines if WARN_LINE.search(l)]
    build = [l.strip() for l in lines if re.search(r"\*\* (BUILD|TEST) (SUCCEEDED|FAILED) \*\*|BUILD (SUCCEEDED|FAILED)", l)]
    errors = extract_errors(text, cap)
    passed = sum(int(m.group(1)) for r in results for m in [re.search(r"(\d+) passed", r)] if m)
    failed = sum(int(m.group(1)) for r in results for m in [re.search(r"(\d+) failed", r)] if m)
    ok = not errors and not failed_tests and failed == 0 and not any("FAILED" in b for b in build)
    tail = [l for l in lines if l.strip()][-3:]
    return {"ok": ok, "lines": len(lines), "errors": errors, "failed_tests": failed_tests[:cap],
            "tests_passed": passed, "tests_failed": failed, "test_results": results[-10:],
            "warnings": len(warnings), "first_warnings": [w.strip()[:200] for w in warnings[:5]], "build": build[-2:], "tail": tail}


def cmd_digest(a):
    """Summarise a cargo/xcodebuild/test/CI log file (or - for stdin): errors, failed tests, results."""
    if a.file == "-":
        text = sys.stdin.read()
    else:
        p = Path(a.file).expanduser()
        if not p.exists():
            raise CliError(f"no such file: {p}")
        text = tail_bytes(p, 32 * 1024 * 1024)
    d = digest_text(text, a.max)
    d["file"] = a.file
    return d


def run_and_digest(cmd, a, cwd=None, env=None):
    if a.dry_run:
        return {"dry_run": True, "command": shlex.join(cmd)}
    t0 = time.time()
    rc, out = run(cmd, cwd=cwd or str(ROOT), timeout=a.timeout, env=env)
    log = Path(tempfile.gettempdir()) / f"agent-cli-{cmd[0]}-{int(t0)}.log"
    try:
        log.write_text(out)
    except OSError:
        log = None
    d = {"command": shlex.join(cmd), "exit": rc, "seconds": round(time.time() - t0, 1), "log": str(log) if log else None}
    d.update(digest_text(out, a.max))
    d["ok"] = d["ok"] and rc == 0
    return d


def cmd_test(a):
    """cargo test -p <crate> [filter], digested (errors, failed tests, test result lines)."""
    cmd = ["cargo", "test", "-p", a.crate] + (["--lib"] if a.lib else []) + (["--features", a.features] if a.features else [])
    if a.filter:
        cmd += ["--", a.filter]
    return run_and_digest(cmd, a)


def cmd_check(a):
    """cargo check -p <crate> (or clippy with --clippy), digested to errors and warning count."""
    cmd = ["cargo", "clippy" if a.clippy else "check", "-p", a.crate, "--message-format", "short"]
    if a.features:
        cmd += ["--features", a.features]
    if a.tests:
        cmd += ["--tests"]
    return run_and_digest(cmd, a)


def cmd_ios_build(a):
    """Build the iPhone app for the simulator (no signing), digested to error lines and BUILD result."""
    dd = Path(a.derived_data or (HOME / "Library" / "Caches" / "Trek" / "ios-dd"))
    cmd = ["xcodebuild", "build", "-project", "ios/Trek.xcodeproj", "-scheme", "Trek", "-configuration", "Debug",
           "-destination", "generic/platform=iOS Simulator", "-derivedDataPath", str(dd), "CODE_SIGNING_ALLOWED=NO", "-quiet"]
    d = run_and_digest(cmd, a)
    if not a.dry_run:
        app = dd / "Build" / "Products" / "Debug-iphonesimulator" / "Trek.app"
        d["app"] = str(app) if app.exists() else None
    return d


def cmd_sims(a):
    """iOS simulators: booted ones first, then Trek-named and newest iPhones (udid, state, runtime)."""
    if shutil.which("xcrun") is None:
        return {"note": "xcrun not available", "devices": []}
    rc, out = run(["xcrun", "simctl", "list", "devices", "available", "--json"], timeout=30)
    if rc != 0:
        raise CliError(out.strip()[-200:])
    devs = []
    for rt, lst in json.loads(out).get("devices", {}).items():
        rtn = rt.rsplit(".", 1)[-1].replace("iOS-", "iOS ").replace("-", ".")
        for x in lst:
            devs.append({"name": x["name"], "udid": x["udid"], "state": x["state"], "runtime": rtn})
    devs.sort(key=lambda x: (x["state"] != "Booted", "trek" not in x["name"].lower(), x["runtime"]), reverse=False)
    booted = [x for x in devs if x["state"] == "Booted"]
    shown = booted + [x for x in devs if x not in booted][: a.n]
    return {"booted": len(booted), "available": len(devs), "devices": shown,
            "_text": [f"{x['state'].lower()} {x['udid']} {x['name']} ({x['runtime']})" for x in shown]}


def cmd_dock(a):
    """Dock tiles and Launch Services records named Trek: a second app record, or a recent-apps tile, means something registered as another Trek."""
    if sys.platform != "darwin":
        return {"note": "macOS only", "records": [], "tiles": {}}
    rc, out = run(["lsappinfo", "list"], timeout=20)
    if rc != 0:
        raise CliError(out.strip()[-200:])
    records = []
    for asn in re.findall(r'^\d+\) "Trek[^"]*" ASN:(0x[0-9a-f]+-0x[0-9a-f]+)', out, re.M):
        _, info = run(["lsappinfo", "info", f"ASN:{asn}"], timeout=10)
        pick = lambda rx: (re.search(rx, info, re.M) or [None, ""])[1]
        rec = {"asn": asn, "name": pick(r'^"([^"]*)"'), "pid": int(pick(r"pid = (\d+)") or 0) or None,
               "type": pick(r'type="([^"]+)"'), "executable": pick(r'executable path="([^"]*)"')}
        orig = pick(r"originalPid=(\d+)")
        if orig:
            rec["original_pid"] = int(orig)
        if rec["pid"]:
            _, cmd = run(["ps", "-o", "ppid=,command=", "-p", str(rec["pid"])], timeout=5)
            rec["command"] = cmd.strip()[:160]
        records.append(rec)
    tiles = {"pinned": 0, "recent": 0}
    try:
        _, xml = run(["plutil", "-convert", "xml1", "-o", "-", os.path.expanduser("~/Library/Preferences/com.apple.dock.plist")], timeout=10)
        d = plistlib.loads(xml.encode("utf-8", "replace"))
        for key, label in (("persistent-apps", "pinned"), ("recent-apps", "recent")):
            tiles[label] = sum(1 for e in d.get(key, []) if e.get("tile-data", {}).get("file-label") == "Trek")
    except Exception as e:  # noqa: BLE001 - a report, not a failure
        tiles["error"] = str(e)[:120]
    # The app itself: Trek.app's main executable, not a record pointing back at it. Background and
    # UI-element records (XPC helpers such as AutoFill) have no tile.
    main = [r for r in records if r["executable"].endswith("/Trek.app/Contents/MacOS/trek") and "original_pid" not in r]
    extra = [r for r in records if r not in main and r["type"] not in ("BackgroundOnly", "UIElement")]
    cleared = None
    if getattr(a, "clear", False) and tiles["recent"]:
        # The Dock keeps its recent apps in its preferences and reloads them on a restart, so
        # a restart alone leaves the tiles; they go by taking them out of the list first.
        plist = os.path.expanduser("~/Library/Preferences/com.apple.dock.plist")
        _, xml = run(["plutil", "-convert", "xml1", "-o", "-", plist], timeout=10)
        d = plistlib.loads(xml.encode("utf-8", "replace"))
        d["recent-apps"] = [e for e in d.get("recent-apps", []) if e.get("tile-data", {}).get("file-label") != "Trek"]
        out = os.path.join(tempfile.gettempdir(), "agent-cli-dock.plist")
        with open(out, "wb") as f:
            plistlib.dump(d, f)
        rc, msg = run(["defaults", "import", "com.apple.dock", out], timeout=10)
        if rc == 0:
            run(["killall", "Dock"], timeout=10)
            cleared, tiles["recent"] = tiles["recent"], 0
        else:
            cleared = f"not cleared: {msg.strip()[-120:]}"
    verdict = ("one Trek, no stale tiles" if len(main) <= 1 and not extra and tiles["recent"] == 0 else
               f"{len(main)} Trek apps, {len(extra)} extra app records, {tiles['recent']} stale recent tiles"
               + (" — find each extra record's pid/command and fix the caller" if extra else "")
               + (" — `agent-cli dock --clear` takes them out of the Dock's recent apps" if tiles["recent"] else ""))
    if isinstance(cleared, int):
        verdict += f" (cleared {cleared} stale recent tiles; the Dock restarted)"
    elif cleared:
        verdict += f" ({cleared})"
    text = [f"{r['name']!r} asn {r['asn']} pid {r['pid']} type {r['type'] or '?'}"
            + (f" originalPid {r['original_pid']}" if r.get("original_pid") else "")
            + (f"  {r.get('command', r['executable'])}" if r.get("pid") else f"  {r['executable']}") for r in records]
    return {"verdict": verdict, "records": records, "tiles": tiles, "_text": text + [f"tiles: pinned {tiles['pinned']}, recent {tiles['recent']}", verdict]}


# ---------------------------------------------------------------- symbolicate

# A release is stripped: Trek's own frames in a freeze file (sample), a panic's backtrace, and a
# macOS .ips, .diag, spin or hang report are offsets in the binary. The release workflow keeps
# the symbols (docs/RELEASING.md, "Symbols"): on the release as Trek-<v>-<platform>.dSYM.zip, and
# for 90 days as the run's artifact trek-symbols-<v>-<platform>.
SYMBOLS_CACHE = HOME / "Library" / "Caches" / "Trek" / "symbols"
TREK_EXES = ("trek", "trek-mcp")
SEMVER = r"\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?"
# crates/trek-logging's binary_image(): "Trek 0.4.64 (aarch64), trek <UUID> at 0x104710000".
IMAGE_LINE = re.compile(rf"\bTrek ({SEMVER}) \((aarch64|x86_64)\)(?:, ([\w.-]+) <([0-9A-Fa-f-]{{36}})> at (0x[0-9a-fA-F]+))?")
# sample (a freeze file, and the freeze's heaviest-stack log line): ???  (in trek)  load address 0x… + 0x…
SAMPLE_FRAME = re.compile(r"\?\?\?(\s+\(in (trek|trek-mcp)\)\s+load address (0x[0-9a-f]+) \+ (0x[0-9a-f]+))")
# A .diag, spin or hang report: ??? (trek + 16286256) [0x105698230]
DIAG_FRAME = re.compile(r"\?\?\?( \((trek|trek-mcp) \+ (\d+)\))")
# std's backtrace of a stripped build, as Trek logs it: "  12:        0x104c3d2a8 - <unknown>"; on a
# Mac each frame takes the one symbol a stripped executable keeps, __mh_execute_header.
RUST_FRAME = re.compile(r"^(\s*\d+:\s+(0x[0-9a-fA-F]+) - )(?:<unknown>|__mh_execute_header)$", re.M)
# A crash report's Binary Images line: 0x104710000 - 0x10ba77fff  dev.trek.Trek 0.4.63 (0.4.63)  <UUID>  /path/trek
BINARY_IMAGE = re.compile(r"^\s*(0x[0-9a-fA-F]+)\s*-\s*(?:0x[0-9a-fA-F]+|\?\?\?)\s+(.*?)\s*<([0-9A-Fa-f-]{36})>\s+(\S.*?)\s*$", re.M)


def sym_platform(arch):
    a = (arch or "").lower().replace("-", "_")
    if a in ("arm64", "arm64e", "aarch64", "arm_64"):
        return "darwin-aarch64"
    if a in ("x86_64", "x86_64h", "x86"):
        return "darwin-x86_64"
    return None


def read_report(path):
    """What a report says about the Trek it came from, and where its unnamed Trek frames are."""
    text = Path(path).read_text(errors="replace")
    r = {"kind": None, "version": None, "arch": None, "images": {}, "text": text, "ips": None}
    first, _, body = text.partition("\n")
    if first.lstrip().startswith("{") and ('"app_name"' in first or '"bug_type"' in first):
        try:
            head, data = json.loads(first), json.loads(body)
        except ValueError:
            head = data = None
        if isinstance(data, dict) and "usedImages" in data:
            r.update(kind="ips", ips=(head, data))
            r["version"] = head.get("build_version") or head.get("app_version") or None
            r["arch"] = data.get("cpuType")
            for img in data.get("usedImages", []):
                name = img.get("name") or Path(img.get("path", "")).name
                if name in TREK_EXES and img.get("uuid"):
                    r["images"][name] = {"uuid": img["uuid"].upper(), "load": img.get("base")}
    if r["kind"] is None and text.lstrip().startswith("{"):
        try:  # a crash report Trek wrote for the next launch: crash-reports/panic-*.json
            data = json.loads(text)
        except ValueError:
            data = None
        if isinstance(data, dict) and "backtrace" in data:
            r.update(kind="panic-report", text=data["backtrace"])
            r["version"] = data.get("version")
            text = data["backtrace"]
    if r["kind"] is None:
        r["kind"] = ("freeze" if text.startswith("Analysis of sampling") else
                     "diag" if DIAG_FRAME.search(text) or "Data Source:" in text[:2000] else
                     "log")
    m = re.search(r"^Version:\s+(\S+)(?: \(([^)]+)\))?", text, re.M)
    if m and not r["version"] and m.group(1) not in ("0", "???"):
        # CFBundleShortVersionString (CFBundleVersion): the second is the full one, a beta's suffix too.
        r["version"] = m.group(2) if m.group(2) and re.fullmatch(SEMVER, m.group(2)) else m.group(1)
    archs = re.findall(r"^(?:Code Type|Architecture):\s+(\S+)", text, re.M)
    if archs and not r["arch"]:
        r["arch"] = archs[-1]  # a .diag names the OS's first, then the process's
    for base, desc, uuid, where in BINARY_IMAGE.findall(text):
        name = Path(where.strip()).name
        if name in TREK_EXES:
            r["images"].setdefault(name, {"uuid": uuid.upper(), "load": int(base, 16)})
    for m in IMAGE_LINE.finditer(text):
        r["version"] = r["version"] or m.group(1)
        r["arch"] = r["arch"] or m.group(2)
        if m.group(3):
            r["images"].setdefault(m.group(3), {"uuid": m.group(4).upper(), "load": int(m.group(5), 16)})
    m = re.search(r"^Load Address:\s+(0x[0-9a-f]+)", text, re.M)
    proc = re.search(r"^Process:\s+(\S+)", text, re.M)
    if m and proc and proc.group(1) in r["images"] and r["images"][proc.group(1)].get("load") is None:
        r["images"][proc.group(1)]["load"] = int(m.group(1), 16)
    r["frames"] = report_frames(r, text)
    return r


def report_frames(r, text):
    """(image, offset) of each frame that wants a name, in order."""
    frames = []
    if r["kind"] == "ips":
        head, data = r["ips"]
        names = [img.get("name") or Path(img.get("path", "")).name for img in data.get("usedImages", [])]
        for th in data.get("threads", []):
            for f in th.get("frames", []):
                i = f.get("imageIndex")
                if isinstance(i, int) and i < len(names) and names[i] in TREK_EXES and "imageOffset" in f:
                    frames.append((names[i], int(f["imageOffset"])))
        return frames
    for m in SAMPLE_FRAME.finditer(text):
        frames.append((m.group(2), int(m.group(4), 16)))
    for m in DIAG_FRAME.finditer(text):
        frames.append((m.group(2), int(m.group(3))))
    image = next((n for n in TREK_EXES if r["images"].get(n, {}).get("load") is not None), None)
    if image:
        base = r["images"][image]["load"]
        for m in RUST_FRAME.finditer(text):
            off = int(m.group(2), 16) - base
            if 0 <= off < 1 << 31:
                frames.append((image, off))
    return frames


def symbol_names(version, platform):
    asset = f"Trek-{version}-{platform}.dSYM.zip"
    return asset, [f"trek-symbols-{version}-{platform}", f"trek-symbols-v{version}-{platform}"]


def dwarf_files(root):
    """{UUID: path} of every dSYM's DWARF file under root."""
    found = {}
    root = Path(root)
    dwarfs = list(root.glob("Contents/Resources/DWARF/*")) if root.name.endswith(".dSYM") else []
    for dwarf in dwarfs or root.glob("**/*.dSYM/Contents/Resources/DWARF/*"):
        rc, out = run(["dwarfdump", "--uuid", str(dwarf)], timeout=60)
        for uuid, arch in re.findall(r"UUID: ([0-9A-F-]{36}) \((\w+)\)", out):
            found[uuid.upper()] = {"path": str(dwarf), "arch": arch}
    return found


def unzip_into(zip_path, dest):
    """Unpack a downloaded zip into a new, empty folder of its own (it is data, never run)."""
    dest = Path(dest)
    dest.mkdir(parents=True, exist_ok=True)
    rc, out = run(["ditto", "-x", "-k", str(zip_path), str(dest)], timeout=600)
    if rc != 0:
        raise CliError(f"couldn't unpack {zip_path}: {out.strip()[-200:]}")
    for inner in list(dest.glob("**/*.dSYM.zip")):  # an artifact holds the release's zip
        unzip_into(inner, inner.parent / (inner.name + ".d"))
        inner.unlink()


def symbol_sources(version, platform, repo, a, tried):
    """Where Trek <version>'s symbols for <platform> may be, in order: --symbols, what was fetched
    before, the release's asset, the release runs' artifacts. Yields (folder, where it's from);
    the caller takes the first whose UUIDs are the binary's."""
    asset, artifacts = symbol_names(version, platform)
    if a.symbols:
        p = Path(a.symbols).expanduser().resolve()
        if p.is_file() and p.suffix == ".zip":
            dest = Path(tempfile.mkdtemp(prefix="trek-symbols-"))
            unzip_into(p, dest / "zip")
            yield dest, str(p)
        elif p.exists():
            yield p, str(p)
        else:
            raise CliError(f"no symbols at {p}")
        return
    cache = SYMBOLS_CACHE / version
    for folder in sorted(cache.glob(f"{platform}*")) if cache.exists() else []:
        if any(folder.glob("**/*.dSYM")):
            tried.append(f"cache {folder}")
            yield folder, f"cache {folder}"
    if not gh_ok():
        tried.append("no fetching (" + ("--offline" if OFFLINE else "gh is missing") + ")")
        return
    work = Path(tempfile.mkdtemp(prefix="trek-symbols-"))
    try:
        # A stable release's tag is v<version>; a beta's or nightly's GitHub release moves with
        # its channel and holds only the newest build's.
        for tag in [f"v{version}"] + (["beta", "nightly"] if "-" in version else []):
            tried.append(f"release {tag}: {asset}")
            dl = work / f"release-{tag}"
            rc, out = run(["gh", "release", "download", tag, "--repo", repo, "--pattern", asset, "--dir", str(dl)], timeout=900)
            if rc == 0 and (dl / asset).exists():
                dest = cache / f"{platform}-release-{tag}"
                shutil.rmtree(dest, ignore_errors=True)
                unzip_into(dl / asset, dest)
                yield dest, f"release {tag} ({asset})"
        for name in artifacts:
            found, err = gh_json(["api", f"repos/{repo}/actions/artifacts?name={name}&per_page=20"])
            arts = (found or {}).get("artifacts", [])
            tried.append(f"artifact {name}: " + (err or f"{len(arts)} found"))
            for art in arts:
                run_id = (art.get("workflow_run") or {}).get("id")
                if art.get("expired"):
                    tried.append(f"artifact {name} of run {run_id}: expired {art.get('expires_at')}")
                    continue
                z = work / f"artifact-{art['id']}.zip"
                rc, _ = run(["sh", "-c", 'gh api "$1" > "$2"', "sh", f"repos/{repo}/actions/artifacts/{art['id']}/zip", str(z)],
                            timeout=900)
                if rc == 0 and z.exists() and z.stat().st_size > 0:
                    dest = cache / f"{platform}-run{run_id}"
                    shutil.rmtree(dest, ignore_errors=True)
                    unzip_into(z, dest)
                    yield dest, f"artifact {name} (run {run_id}, kept until {art.get('expires_at')})"
    finally:
        shutil.rmtree(work, ignore_errors=True)


def text_size(dwarf):
    """__TEXT's size in a dSYM's DWARF file: offsets past it aren't Trek's code."""
    rc, out = run(["otool", "-l", dwarf], timeout=60)
    m = re.search(r"segname __TEXT\s+vmaddr (0x[0-9a-f]+)\s+vmsize (0x[0-9a-f]+)", out)
    return int(m.group(2), 16) if m else 1 << 31


def atos_names(dwarf, arch, offsets):
    """{offset: "innermost (file:line) < … < function (file:line)"} from atos, demangled."""
    offsets = sorted(set(offsets))
    names = {}
    delim = "@@agent-cli@@"
    for i in range(0, len(offsets), 400):
        chunk = offsets[i:i + 400]
        rc, out = run(["atos", "-o", dwarf, "-arch", arch, "-i", "-d", delim, "-offset", *[hex(o) for o in chunk]], timeout=300)
        blocks = out.split(delim)
        blocks = [b.strip("\n") for b in blocks[:-1]] if out.rstrip().endswith(delim) else None
        if rc != 0 or blocks is None or len(blocks) != len(chunk):
            # Inline frames didn't line up with the addresses: one name per address, without them.
            rc, out = run(["atos", "-o", dwarf, "-arch", arch, "-offset", *[hex(o) for o in chunk]], timeout=300)
            blocks = out.rstrip("\n").split("\n") if rc == 0 else []
            if len(blocks) != len(chunk):
                raise CliError(f"atos gave {len(blocks)} answers for {len(chunk)} addresses: {out.strip()[-200:]}")
        for off, block in zip(chunk, blocks):
            parts = [re.sub(r" \(in [^)]*\)", "", l).strip() for l in block.splitlines() if l.strip()]
            parts = [p for p in parts if not re.fullmatch(r"0x[0-9a-f]+", p)]
            if parts:
                names[off] = " < ".join(parts)
    if names and shutil.which("c++filt"):  # Rust's v0 names (_RNv…); c++filt reads them
        keys = list(names)
        p = subprocess.run(["c++filt"], input="\n".join(names[k] for k in keys) + "\n", text=True,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        lines = p.stdout.split("\n")
        if p.returncode == 0 and len(lines) >= len(keys):
            names = {k: lines[n] for n, k in enumerate(keys)}
    return names


def render_ips(r, named):
    head, data = r["ips"]
    imgs = data.get("usedImages", [])
    names = [img.get("name") or Path(img.get("path", "")).name for img in imgs]
    exc = data.get("exception", {})
    out = [f"{head.get('name') or data.get('procName')} {r['version'] or '?'} ({data.get('cpuType')})  "
           f"{exc.get('type', '')} {exc.get('signal', '')}".rstrip()]
    term = data.get("termination", {})
    if term.get("indicator") or term.get("reasons"):
        out.append(f"termination: {term.get('indicator', '')} {' '.join(term.get('reasons', []))}".strip())
    for n, th in enumerate(data.get("threads", [])):
        label = " ".join(x for x in (f"Thread {n}", th.get("name") or "", f"({th['queue']})" if th.get("queue") else "",
                                     "crashed" if th.get("triggered") else "") if x)
        out.append("")
        out.append(label + ":")
        for k, f in enumerate(th.get("frames", [])):
            i = f.get("imageIndex")
            image = names[i] if isinstance(i, int) and i < len(names) else "???"
            off = f.get("imageOffset", 0)
            name = named.get((image, off)) or (f"{f['symbol']} + {f.get('symbolLocation', 0)}" if f.get("symbol") else "???")
            out.append(f"{k:<3} {image:<28} {name}  ({image} + {off})")
    return out


def named_text(r, named):
    """The report's lines with each named frame's name in place of its ??? (an .ips: its threads)."""
    if r["kind"] == "ips":
        return render_ips(r, named)

    def sample_sub(m):
        n = named.get((m.group(2), int(m.group(4), 16)))
        return f"{n}{m.group(1)}" if n else m.group(0)

    def diag_sub(m):
        n = named.get((m.group(2), int(m.group(3))))
        return f"{n}{m.group(1)}" if n else m.group(0)
    image = next((n for n in TREK_EXES if r["images"].get(n, {}).get("load") is not None), None)

    def rust_sub(m):
        n = named.get((image, int(m.group(2), 16) - r["images"][image]["load"])) if image else None
        return f"{m.group(1)}{n}" if n else m.group(0)
    return RUST_FRAME.sub(rust_sub, DIAG_FRAME.sub(diag_sub, SAMPLE_FRAME.sub(sample_sub, r["text"]))).splitlines()


SYMBOLICATE_FIXTURES = ROOT / "script" / "tests" / "fixtures" / "symbolicate"


def symbolicate_units():
    """symbolicate's reading and naming of each kind of report, on fixtures (no atos, no network)."""
    want = {  # file: (kind, version, platform, trek's UUID, its load address, frames, a frame and where its name goes)
        "freeze.txt": ("freeze", "0.4.64", "darwin-aarch64", "0F1E2D3C-4B5A-6978-8796-A5B4C3D2E1F0", 0x104c84000, 3,
                       ("trek", 0xcd4d64), "fake::hold  (in trek)  load address 0x104c84000 + 0xcd4d64"),
        "report.diag": ("diag", "0.4.63", "darwin-aarch64", "2F2D0CB7-2A2F-397E-A644-A954494E8264", 0x104710000, 3,
                        ("trek", 16286256), "fake::hold (trek + 16286256) [0x105698230]"),
        "crash.ips": ("ips", "0.4.64-beta.2", "darwin-x86_64", "6576D418-4C72-3B4A-BD13-936E6CB748B2", 4295000064, 2,
                      ("trek", 74580), "fake::hold  (trek + 74580)"),
        "panic.log": ("log", "0.4.64", "darwin-aarch64", "0F1E2D3C-4B5A-6978-8796-A5B4C3D2E1F0", 0x104710000, 2,
                      ("trek", 0x2a8), "0x1047102a8 - fake::hold"),
    }
    results = []
    for name, (kind, version, platform, uuid, load, frames, frame, shown) in want.items():
        try:
            r = read_report(SYMBOLICATE_FIXTURES / name)
            img = r["images"].get("trek", {})
            got = (r["kind"], r["version"], sym_platform(r["arch"]), img.get("uuid"), img.get("load"), len(r["frames"]))
            text = "\n".join(named_text(r, {frame: "fake::hold"}))
            ok = got == (kind, version, platform, uuid, load, frames) and frame in r["frames"] and shown in text
            why = "" if ok else f"read {got}, frames {r['frames'][:4]}, named: {shown in text}"
        except Exception as e:  # a fixture that can't be read is a failure, not a crash of the selftest
            ok, why = False, repr(e)
        results.append({"cmd": f"unit symbolicate {name}", "ok": ok, **({"why": why} if not ok else {})})
    return results


def cmd_symbolicate(a):
    """Name Trek's frames in a freeze file, a panic's backtrace, or a macOS .ips/.diag report from a release's saved symbols (atos)."""
    path = Path(a.file).expanduser()
    if not path.exists():
        raise CliError(f"no file {path}")
    r = read_report(path)
    version = (a.version or r["version"] or "").lstrip("v") or None
    arch = a.arch or r["arch"]
    platform = sym_platform(arch)
    wanted = sorted({img for img, _ in r["frames"]})
    d = {"file": str(path), "kind": r["kind"], "version": version, "arch": arch, "platform": platform,
         "images": {n: {"uuid": i.get("uuid"), "load": hex(i["load"]) if isinstance(i.get("load"), int) else None}
                    for n, i in r["images"].items()},
         "frames": len(r["frames"])}
    if not r["frames"]:
        d["note"] = "no unnamed Trek frames in it: nothing to name"
        d["_text"] = [f"{path}: {r['kind']}, Trek {version or '?'} {arch or '?'}: no unnamed Trek frames in it"]
        return d
    if not version:
        raise CliError(f"{path} doesn't say which Trek it came from: pass --version")
    if not platform:
        raise CliError(f"{path} doesn't say which architecture (got {arch!r}): pass --arch arm64 or x86_64")
    asset, artifacts = symbol_names(version, platform)
    d["looks_for"] = [asset + " on its release", artifacts[0] + " (release workflow artifact)"]
    if a.parse_only:
        d["_text"] = [f"{path}: {r['kind']}, Trek {version} {arch} ({platform}), {len(r['frames'])} frames to name in "
                      + ", ".join(f"{n} <{r['images'].get(n, {}).get('uuid', '?')}>" for n in wanted),
                      f"symbols: {d['looks_for'][0]}, else {d['looks_for'][1]}"]
        return d
    repo = a.repo or repo_slug() or "dokyit/Trek"
    atos_arch = "arm64" if platform == "darwin-aarch64" else "x86_64"
    want = {img: r["images"].get(img, {}).get("uuid") for img in wanted}
    tried, others, chosen = [], [], None
    for folder, source in symbol_sources(version, platform, repo, a, tried):
        dwarfs = dwarf_files(folder)
        match = {}
        for image, uuid in want.items():
            if uuid and uuid in dwarfs:
                match[image] = dwarfs[uuid]
            elif uuid is None:
                # No UUID in the file (a log line from before Trek wrote one): the dSYM of that
                # name, unchecked.
                guess = next((v for v in dwarfs.values() if Path(v["path"]).parts[-5] == image + ".dSYM"), None)
                if guess:
                    match[image] = guess
                    d.setdefault("unchecked", []).append(f"{image}: no UUID in the file, so the symbols weren't checked against it")
        if match:
            chosen = (source, match)
            break
        others.append(f"{source}: " + (", ".join(f"<{u}>" for u in dwarfs) or "no dSYM"))
    if chosen is None:
        asks = ", ".join(f"{i} <{u}>" for i, u in want.items())
        if others:
            raise CliError(f"no symbols for {asks}: the ones found for Trek {version} are another build's, so they'd name "
                           f"the wrong code ({'; '.join(others)})")
        if any(t.startswith("no fetching") for t in tried):
            raise CliError(f"Trek {version}'s symbols for {platform} aren't in {SYMBOLS_CACHE / version}, and {tried[-1][13:-1]} "
                           f"fetches nothing: pass --symbols, or let it fetch {asset}")
        raise CliError(f"Trek {version}'s symbols for {platform} were never saved, or have expired: no {asset} on its release "
                       f"and no artifact {artifacts[0]} in {repo} ({'; '.join(tried)}). Releases keep them since the release "
                       "workflow started to; an older build's frames stay offsets (a rebuild of its tag has other paths in it, "
                       "so other UUIDs, and can't stand in).")
    source, match = chosen
    d["symbols"] = source
    named, missing = {}, []
    for image in wanted:
        if image not in match:
            missing.append(f"{image} <{want[image]}>: not in {source}")
            continue
        offs = [o for img, o in r["frames"] if img == image]
        limit = text_size(match[image]["path"])
        names = atos_names(match[image]["path"], atos_arch, [o for o in offs if o < limit])
        named.update({(image, o): n for o, n in names.items()})
    if missing:
        d["not_named"] = missing
    lines = named_text(r, named)
    unique = {}
    for img, off in r["frames"]:
        if (img, off) in named:
            unique.setdefault((img, off), named[(img, off)])
    hits = sum(1 for f in r["frames"] if f in named)
    d.update(named=hits, unnamed=len(r["frames"]) - hits,
             names=[{"image": i, "offset": hex(o), "name": n} for (i, o), n in list(unique.items())[:300]])
    if a.out:
        Path(a.out).write_text("\n".join(lines) + "\n")
        d["out"] = a.out
    head = [f"# {path.name}: Trek {version} {arch}, {hits} of {len(r['frames'])} Trek frames named from {source}"]
    head += [f"# not named: {m}" for m in missing] + [f"# {u}" for u in d.get("unchecked", [])]
    d["_text"] = head + ([f"# written to {a.out}"] if a.out else lines)
    return d


# ---------------------------------------------------------------- output

def render(data, prefix=""):
    lines = []
    for k, v in data.items():
        if k.startswith("_"):
            continue
        key = f"{prefix}{k}"
        if isinstance(v, dict):
            if not v:
                continue
            if all(not isinstance(x, (dict, list)) for x in v.values()):
                lines.append(f"{key} " + " ".join(f"{kk}={vv}" for kk, vv in v.items()))
            else:
                lines.extend(render(v, key + "."))
        elif isinstance(v, list):
            if not v:
                continue
            for item in v:
                if isinstance(item, dict):
                    parts = []
                    for kk, vv in item.items():
                        if isinstance(vv, list):
                            continue
                        parts.append(f"{kk}={vv}")
                    lines.append(f"{key} " + " ".join(parts))
                    for kk, vv in item.items():
                        if isinstance(vv, list):
                            lines.extend(f"  {kk} {x}" for x in vv)
                else:
                    lines.append(f"{key} {item}")
        elif v is None:
            continue
        elif isinstance(v, str) and "\n" in v:
            lines.append(f"{key}:")
            lines.append(v)
        else:
            lines.append(f"{key} {v}")
    return lines


def emit(data, as_json):
    if as_json:
        print(json.dumps({k: v for k, v in data.items() if not k.startswith("_")}, ensure_ascii=False, default=str))
    else:
        print("\n".join(data["_text"]) if "_text" in data else "\n".join(render(data)))


# ---------------------------------------------------------------- perf

PERF_WHAT = ("launch", "idle", "stream", "long", "checkpoint", "memory")
# The same settings as verify-trek's isolated profile: the mock agent only, nothing imported.
PERF_SETTINGS = """[general]
default_agent = "direct:mock"

[onboarding]
completed = true
version = 2

[import]
claude_code = false
codex = false
opencode = false

[notifications]
mode = "off"
dock_badge = false
menu_bar_icon = false

[updates]
auto_check = false
auto_download = false
"""


def median(values):
    values = sorted(v for v in values if v is not None)
    return values[(len(values) - 1) // 2] if values else None


class PerfTrek:
    """One isolated Trek: a throwaway data folder, the mock agent, driven through the shots harness."""

    def __init__(self, binary, work, name, seed=None, force_active=False, size="1280x820", poll_ms=None, test_display=False):
        self.binary = binary
        self.dir = Path(work) / name
        self.data = self.dir / "data"
        self.shot = self.dir / "shot"
        if self.dir.exists():
            shutil.rmtree(self.dir)
        self.shot.mkdir(parents=True)
        if seed:
            shutil.copytree(seed, self.data)
        else:
            self.data.mkdir(parents=True)
        (self.data / "settings.toml").write_text(PERF_SETTINGS)
        self.env = {**os.environ, "TREK_DATA_DIR": str(self.data), "TREK_SHOT_DIR": str(self.shot), "TREK_PERF": "1",
                    "TREK_MOCK_AGENT": "1", "TREK_BACKGROUND": "1", "TREK_WINDOW_SIZE": size,
                    "RUST_LOG": "warn,trek=info"}
        # 60 Hz of frame requests behind other windows: for frame times, never for idle numbers.
        if force_active:
            self.env["TREK_FORCE_ACTIVE"] = "1"
        # A display of its own that nobody sees (verify-trek's "Trek Test Display"): macOS draws
        # the window there at the display's rate, and none of it is on the owner's screens.
        if test_display:
            self.env["TREK_TEST_DISPLAY"] = "1"
        # The harness looks for commands every 300 ms: slower when counting Trek's own wakeups.
        if poll_ms:
            self.env["TREK_SHOT_POLL_MS"] = str(poll_ms)
        self.spawned_ms = None
        self.proc = None

    def start(self):
        self.spawned_ms = time.time() * 1000
        self.proc = subprocess.Popen([str(self.binary)], cwd=str(self.dir), env=self.env, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return self

    def lines(self):
        """The `perf:` lines logged so far, each as a dict with its kind."""
        out = []
        for log in sorted((self.data / "logs").glob("trek-*.log")):
            for line in strip_ansi(log.read_text(errors="replace")).splitlines():
                m = re.search(r"\sperf: (\w+)(.*)$", line)
                if m:
                    out.append({"kind": m.group(1), **dict(re.findall(r"(\w+)=(\S+)", m.group(2)))})
        return out

    def wait_line(self, kind, timeout=120, label=None):
        end = time.time() + timeout
        while time.time() < end:
            hits = [l for l in self.lines() if l["kind"] == kind and (label is None or l.get("label") == label)]
            if hits:
                return hits[-1]
            if self.proc.poll() is not None:
                raise CliError(f"Trek exited ({self.proc.returncode}) before logging perf: {kind}; see {self.data}/logs")
            time.sleep(0.05)
        raise CliError(f"no perf: {kind} within {timeout}s; see {self.data}/logs")

    def batch(self, lines, timeout=600):
        done = self.shot / "done"
        done.unlink(missing_ok=True)
        tmp = self.shot / ".cmd.tmp"
        tmp.write_text("\n".join(lines) + "\n")
        tmp.rename(self.shot / "cmd")
        end = time.time() + timeout
        while not done.exists():
            if self.proc.poll() is not None:
                raise CliError(f"Trek exited ({self.proc.returncode}) mid-batch; see {self.data}/logs")
            if time.time() > end:
                raise CliError(f"batch timed out: {lines}")
            time.sleep(0.1)
        said = done.read_text().strip()
        if said != "ok":
            raise CliError(f"batch failed: {said}")

    def sample(self):
        """(RSS in MB, CPU seconds so far), as `ps` has them."""
        rc, out = run(["ps", "-o", "rss=,cputime=", "-p", str(self.proc.pid)])
        if rc != 0 or not out.strip():
            raise CliError("Trek isn't running to sample")
        rss, cpu = out.split()
        secs = 0.0
        for part in cpu.split(":"):
            secs = secs * 60 + float(part)
        return int(rss) / 1024, secs

    def footprint(self):
        """Physical footprint in MB, what Activity Monitor calls Memory (GPU memory included)."""
        rc, out = run(["footprint", str(self.proc.pid)], timeout=60)
        m = re.search(r"phys_footprint:\s*([\d.]+)\s*(KB|MB|GB)", out) or re.search(r"Footprint:\s*([\d.]+)\s*(KB|MB|GB)", out)
        if rc != 0 or not m:
            return None
        return float(m.group(1)) * {"KB": 1 / 1024, "MB": 1, "GB": 1024}[m.group(2)]

    def footprint_parts(self, top=6):
        """(footprint in MB, its largest categories as {name: MB}): where the memory is. Decoded
        pictures and text are under the Malloc rows, textures under IOAccelerator/IOSurface."""
        rc, out = run(["footprint", str(self.proc.pid)], timeout=60)
        unit = {"B": 1 / 2**20, "KB": 1 / 1024, "MB": 1, "GB": 1024}
        m = re.search(r"phys_footprint:\s*([\d.]+)\s*(KB|MB|GB)", out) or re.search(r"Footprint:\s*([\d.]+)\s*(KB|MB|GB)", out)
        if rc != 0 or not m:
            return None, {}
        rows = re.findall(r"^\s*([\d.]+) (B|KB|MB|GB)\s+[\d.]+ (?:B|KB|MB|GB)\s+[\d.]+ (?:B|KB|MB|GB)\s+\d+\s+(\S.*?)\s*$", out, re.M)
        parts = sorted(((name, float(n) * unit[u]) for n, u, name in rows if name != "TOTAL"), key=lambda r: -r[1])
        return float(m.group(1)) * unit[m.group(2)], {name: round(mb, 1) for name, mb in parts[:top] if mb >= 1}

    def over(self, secs):
        """Average CPU (% of one core) and context switches a second over `secs`, Trek left alone."""
        _, before = self.sample()
        rc, out = run(["top", "-l", "2", "-s", str(int(secs)), "-pid", str(self.proc.pid), "-stats", "pid,csw"], timeout=secs + 60)
        _, after = self.sample()
        rows = [l.split() for l in out.splitlines() if l.strip().startswith(str(self.proc.pid))]
        switches = None
        if rc == 0 and len(rows) >= 2:
            switches = (float(rows[-1][1].rstrip("+-")) - float(rows[0][1].rstrip("+-"))) / secs
        return (after - before) / secs * 100, switches

    def stop(self):
        if not self.proc or self.proc.poll() is not None:
            return
        try:
            (self.shot / ".cmd.tmp").write_text("quit\n")
            (self.shot / ".cmd.tmp").rename(self.shot / "cmd")
            self.proc.wait(timeout=20)
        except (OSError, subprocess.TimeoutExpired):
            self.proc.terminate()
            try:
                self.proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait()

    def __enter__(self):
        return self.start()

    def __exit__(self, *_):
        self.stop()


def perf_seed(seed_bin, work, threads, long_rounds, memo={}):
    """A data folder of `threads` threads made by trek-core's perf_seed; None for an empty one."""
    if not threads:
        return None
    key = (threads, long_rounds)
    if key not in memo:
        seed = Path(work) / f"seed-{threads}-{long_rounds}"
        env = {**os.environ, "TREK_DATA_DIR": str(seed), "SEED_THREADS": str(threads), "SEED_LONG": str(long_rounds)}
        rc, out = run([str(seed_bin)], env=env, timeout=600)
        if rc != 0:
            raise CliError(f"perf_seed: {out.strip()[-300:]}")
        memo[key] = seed
    return memo[key]


def perf_launch(a, trek_bin, seed_bin, work, say):
    """Launch to the first painted frame of the main window, by spawn time and the app's own log."""
    out = {}
    for n in a.thread_counts:
        seed = perf_seed(seed_bin, work, n, 4)
        warm = []
        # The first launch of a new binary path pays for the system's first look at it: not warm.
        for run_ix in range(a.runs + 1):
            with PerfTrek(trek_bin, work, f"warm-{n}", seed) as t:
                s = t.wait_line("startup")
                took = float(s["at"]) - t.spawned_ms
                if run_ix:
                    warm.append(took)
                last = s
        out[f"warm_{n}_threads_ms"] = round(median(warm))
        out[f"warm_{n}_threads_runs"] = [round(w) for w in warm]
        out[f"warm_{n}_threads_phases_ms"] = {k: float(v) for k, v in last.items() if k not in ("kind", "at")}
        say(f"launch warm, {n} threads: {out[f'warm_{n}_threads_ms']} ms (runs {out[f'warm_{n}_threads_runs']})")
    # Cold: Trek and its data on a volume of their own, unmounted and mounted again before each
    # run, so none of their pages are left in the file cache. (No `purge` without root; system
    # libraries stay cached, as they do on any Mac that has been up a while.)
    if IS_MAC:
        n = max(a.thread_counts)
        seed = perf_seed(seed_bin, work, n, 4)
        image, mount = Path(work) / "cold.sparseimage", Path(work) / "cold"
        attach = ["hdiutil", "attach", str(image), "-nobrowse", "-noautoopen", "-mountpoint", str(mount), "-quiet"]
        detach = ["hdiutil", "detach", str(mount), "-force", "-quiet"]
        rc, said = run(["hdiutil", "create", "-size", "2g", "-fs", "APFS", "-type", "SPARSE", "-volname", "TrekPerfCold", "-quiet", str(image)], timeout=120)
        if rc == 0 and run(attach, timeout=120)[0] == 0:
            shutil.copy2(trek_bin, mount / "trek")
            cold = []
            try:
                if seed:
                    shutil.copytree(seed, mount / "seed")
                for _ in range(a.cold_runs):
                    run(detach, timeout=120)
                    if run(attach, timeout=120)[0] != 0:
                        break
                    with PerfTrek(mount / "trek", mount, "cold", mount / "seed" if seed else None) as t:
                        s = t.wait_line("startup")
                        cold.append(float(s["at"]) - t.spawned_ms)
            finally:
                run(detach, timeout=120)
            out[f"cold_{n}_threads_ms"] = round(median(cold)) if cold else None
            out[f"cold_{n}_threads_runs"] = [round(c) for c in cold]
            say(f"launch cold, {n} threads: {out[f'cold_{n}_threads_ms']} ms (runs {out[f'cold_{n}_threads_runs']})")
        else:
            say(f"launch cold: no volume ({said.strip()[-200:]})")
    return out


def perf_idle(a, trek_bin, seed_bin, work, say):
    """RSS, footprint, CPU and wakeups of a Trek left alone, with 0, 10 and 100 threads."""
    out = {}
    for n in a.thread_counts:
        seed = perf_seed(seed_bin, work, n, 4)
        with PerfTrek(trek_bin, work, f"idle-{n}", seed, poll_ms=5000) as t:
            t.wait_line("startup")
            # Past the warm-up pass 10 s after launch.
            time.sleep(a.settle)
            rss, _ = t.sample()
            foot = t.footprint()
            cpu, switches = t.over(a.idle_secs)
            rss_after, _ = t.sample()
        out[f"{n}_threads"] = {"rss_mb": round(rss), "footprint_mb": foot and round(foot), "cpu_percent": round(cpu, 2),
                               "switches_per_s": switches if switches is None else round(switches, 1),
                               "rss_after_mb": round(rss_after), "secs": a.idle_secs}
        say(f"idle, {n} threads: RSS {round(rss)} MB, footprint {foot and round(foot)} MB, CPU {cpu:.2f}% over {a.idle_secs}s, {out[f'{n}_threads']['switches_per_s']} context switches/s")
    # A window behind others isn't drawn after its first frame: memory with it drawn, as in front.
    n = max(a.thread_counts)
    with PerfTrek(trek_bin, work, "idle-drawn", perf_seed(seed_bin, work, n, 4), force_active=True) as t:
        t.wait_line("startup")
        time.sleep(a.settle)
        foot = t.footprint()
    out["drawn"] = {"threads": n, "footprint_mb": foot and round(foot)}
    say(f"idle, {n} threads, the window drawn as in front: footprint {foot and round(foot)} MB")
    # The same, on screen: macOS runs a window's display link only while it can be seen.
    if a.front:
        n = max(a.thread_counts)
        with PerfTrek(trek_bin, work, "idle-front", perf_seed(seed_bin, work, n, 4), size="640x420") as t:
            t.wait_line("startup")
            time.sleep(a.settle)
            t.batch(["perf front"], timeout=30)
            visible = t.wait_line("front")["visible"] == "true"
            cpu, switches = t.over(a.front_secs)
        out["on_screen"] = {"threads": n, "visible": visible, "cpu_percent": round(cpu, 2), "secs": a.front_secs,
                            "switches_per_s": switches if switches is None else round(switches, 1)}
        say(f"idle on screen, {n} threads: visible {visible}, CPU {cpu:.2f}% over {a.front_secs}s, {out['on_screen']['switches_per_s']} context switches/s")
    return out


def perf_stream(a, trek_bin, seed_bin, work, say):
    """A long mock answer streaming in the thread on screen: RSS, CPU and frame times."""
    seed = perf_seed(seed_bin, work, 100, 4)
    with PerfTrek(trek_bin, work, "stream", seed, force_active=True) as t:
        t.wait_line("startup")
        time.sleep(a.settle)
        rss_start, cpu_start = t.sample()
        t.batch(["pace 1", f"route project:{seed}/projects/atlas-api", f"send mock:stream {a.stream_secs}s", "wait 1000"], timeout=120)
        began = time.time()
        rss_peak = rss_start
        while time.time() - began < a.stream_secs - 10:
            time.sleep(5)
            rss_peak = max(rss_peak, t.sample()[0])
        t.batch(["perf frames 3000 stream-late"], timeout=60)
        frames = t.wait_line("frames", label="stream-late")
        rss_end, cpu_end = t.sample()
        rss_peak = max(rss_peak, rss_end)
        took = time.time() - began
        t.batch([f"wait idle {(a.stream_secs + 120) * 1000}", "wait 500"], timeout=a.stream_secs + 180)
        time.sleep(a.settle)
        rss_after, _ = t.sample()
    out = {"rss_start_mb": round(rss_start), "rss_peak_mb": round(rss_peak), "rss_after_settling_mb": round(rss_after),
           "cpu_percent": round((cpu_end - cpu_start) / took * 100, 1), "secs": round(took),
           "frame_p50_ms": float(frames["frame_p50"]), "frame_p95_ms": float(frames["frame_p95"]),
           "frames_in_3s": int(frames["frames"]), "lag_p95_ms": float(frames["lag_p95"])}
    say(f"stream, {a.stream_secs}s: RSS {out['rss_start_mb']} to {out['rss_peak_mb']} MB, CPU {out['cpu_percent']}%, frames p50 {out['frame_p50_ms']} / p95 {out['frame_p95_ms']} ms")
    return out


def perf_long(a, trek_bin, seed_bin, work, say):
    """Opening and scrolling a thread of `--long-items` items, and what it keeps in memory."""
    rounds = max(a.long_items // 5, 1)
    seed = perf_seed(seed_bin, work, 1, rounds)
    with PerfTrek(trek_bin, work, "long", seed, force_active=True) as t:
        t.wait_line("startup")
        time.sleep(a.settle)
        rss_before, _ = t.sample()
        t.batch(["perf open Long transcript"], timeout=300)
        opened = t.wait_line("open")
        rss_open, _ = t.sample()
        t.batch(["wait 2000", f"perf scroll answer#{rounds * 5 - 2} -100 300 transcript-up"], timeout=300)
        s = t.wait_line("scroll", label="transcript-up")
        rss_scrolled, _ = t.sample()
        # A new answer streaming at the end of all that history.
        t.batch(["pace 1", "send mock:stream 20s", "wait 8000", "perf frames 3000 long-stream", "wait idle 60000"], timeout=120)
        f = t.wait_line("frames", label="long-stream")
    out = {"items": rounds * 5, "loaded_ms": float(opened["loaded"]), "first_paint_ms": float(opened["painted"]),
           "rss_before_mb": round(rss_before), "rss_opened_mb": round(rss_open), "rss_scrolled_mb": round(rss_scrolled),
           "scroll_frame_p50_ms": float(s["frame_p50"]), "scroll_frame_p95_ms": float(s["frame_p95"]), "scroll_frames": int(s["frames"]),
           "scroll_latency_p50_ms": float(s["latency_p50"]), "scroll_latency_p95_ms": float(s["latency_p95"]), "scroll_unpainted": int(s["unpainted"]),
           "stream_frame_p50_ms": float(f["frame_p50"]), "stream_frame_p95_ms": float(f["frame_p95"]), "stream_lag_p95_ms": float(f["lag_p95"]), "stream_frames_in_3s": int(f["frames"])}
    say(f"long thread, {out['items']} items: loaded {out['loaded_ms']} ms, painted {out['first_paint_ms']} ms, RSS {out['rss_before_mb']} to {out['rss_opened_mb']} to {out['rss_scrolled_mb']} MB, scroll p50 {out['scroll_frame_p50_ms']} / p95 {out['scroll_frame_p95_ms']} ms, streaming p50 {out['stream_frame_p50_ms']} / p95 {out['stream_frame_p95_ms']} ms")
    return out


def perf_big_repo(work, files):
    """A git repo of `files` small files, committed, for checkpoints to read."""
    repo = Path(work) / f"repo-{files}"
    repo.mkdir(parents=True)
    body = "// A source file of about the size real ones are.\n" * 80
    for i in range(files):
        d = repo / f"pkg{i % 100:02}" / f"mod{i % 1000:03}"
        d.mkdir(parents=True, exist_ok=True)
        (d / f"file{i}.rs").write_text(f"// {i}\n{body}")
    g = ["git", "-c", "user.name=perf", "-c", "user.email=perf@example.invalid", "-c", "commit.gpgSign=false"]
    for args in (["init", "-q", "-b", "main"], ["add", "-A"], ["commit", "-qm", "seed"]):
        rc, said = run([*g, *args], cwd=str(repo), timeout=1800)
        if rc != 0:
            raise CliError(f"git {args[0]}: {said.strip()[-200:]}")
    return repo


def perf_checkpoint(a, trek_bin, seed_bin, work, say):
    """What a turn's file checkpoint costs (off the main thread), and how long the agent waits for it."""
    ck_bin = Path(seed_bin).parent / "perf_checkpoint"
    out = {}
    big = Path(a.big_repo) if a.big_repo else perf_big_repo(work, a.big_repo_files)
    # This repo as a clone of its own: a turn leaves checkpoint refs in the repo it runs in.
    this = Path(work) / "this-repo"
    rc, said = run(["git", "clone", "-q", "--shared", str(ROOT), str(this)], timeout=600)
    if rc != 0:
        raise CliError(f"git clone: {said.strip()[-200:]}")
    for name, repo in (("this repo", this), ("big repo", big)):
        rc, said = run([str(ck_bin), str(repo), str(a.runs)], timeout=1800)
        if rc != 0:
            raise CliError(f"perf_checkpoint: {said.strip()[-300:]}")
        d = json.loads(said.strip().splitlines()[-1])
        # The first token as Trek's transcript sees it, with the mock agent, which has no model to
        # wait for. The first turn starts its session too; after that, what's left is how long the
        # message waited for the checkpoint (each run a few turns, the medians reported).
        with PerfTrek(trek_bin, work, "first-token") as t:
            t.wait_line("startup")
            lines = [f"route project:{repo}", "send mock:stream 2s", "wait idle 60000"]
            for _ in range(a.runs):
                # Past the checkpoint that ended the turn before.
                lines += [f"wait {max(5000, d['first_ms'] * 2)}", "send mock:stream 2s", "wait idle 60000"]
            t.batch(lines, timeout=(a.runs + 1) * 90)
            tokens = [float(l["ms"]) for l in t.lines() if l["kind"] == "first_token"]
        d["first_token_new_session_ms"] = tokens[0]
        d["first_token_ms"] = median(tokens[1:])
        d["first_token_runs_ms"] = tokens[1:]
        out[name] = d
        failed = f" (failed: {d['failed']})" if d.get("failed") else ""
        say(f"checkpoint, {name}: {d['files']} files, first {d['first_ms']} ms, then p50 {d['p50_ms']} ms{failed}; first token after {d['first_token_ms']} ms (runs {tokens[1:]}), {d['first_token_new_session_ms']} ms with a new session")
    return out


def perf_png(path, width, height):
    """A `width`×`height` RGB PNG the size a screenshot is on disk: a gradient, with noise in part of each row."""
    import struct
    import zlib
    base = bytes((x * 255 // width + c * 40) % 256 for x in range(width) for c in range(3))
    noisy = min(width // 8, 400) * 3
    raw = bytearray()
    for y in range(height):
        raw += b"\x00" + os.urandom(noisy) + base[noisy:] if y % 4 == 0 else b"\x02" + bytes(noisy) + base[noisy:]

    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)

    Path(path).write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
                           + chunk(b"IDAT", zlib.compress(bytes(raw), 1)) + chunk(b"IEND", b""))


# The pictures the memory stress attaches: the sizes screenshots come in (a 15" and a 14" Retina
# screen, a 3000×2000 photo, a 1080p-class window, a small one).
MEMORY_PICTURES = ((3000, 2000), (2880, 1800), (3024, 1964), (1920, 1200), (1280, 800))


def perf_memory(a, trek_bin, seed_bin, work, say):
    """What a session of many threads, long answers and pictures leaves in memory, phase by phase."""
    heavy, picture_threads, rounds = a.mem_heavy, a.mem_picture_threads, 5
    pictures = Path(work) / "pictures"
    pictures.mkdir()
    decoded = 0
    for n in range(picture_threads * rounds * 3):
        w, h = MEMORY_PICTURES[n % len(MEMORY_PICTURES)]
        perf_png(pictures / f"shot-{n:03}.png", w, h)
        decoded += w * h * 4
    seed = Path(work) / "seed-memory"
    env = {**os.environ, "TREK_DATA_DIR": str(seed), "SEED_THREADS": "20", "SEED_LONG": "4", "SEED_HEAVY": str(heavy),
           "SEED_IMAGE_THREADS": str(picture_threads), "SEED_IMAGE_ROUNDS": str(rounds), "SEED_IMAGE_DIR": str(pictures),
           "SEED_ARTIFACTS": "1"}
    rc, said = run([str(seed_bin)], env=env, timeout=600)
    if rc != 0:
        raise CliError(f"perf_seed: {said.strip()[-300:]}")
    heavy_titles = [f"Heavy thread #{i:02}" for i in range(heavy)]
    picture_titles = [f"Image thread #{i:02}" for i in range(picture_threads)]
    out = {"heavy_threads": heavy, "picture_threads": picture_threads, "pictures": picture_threads * rounds * 3,
           "pictures_decoded_mb": round(decoded / 2**20), "phases": {}}
    # On a display of its own, drawn at its rate: pictures are only uploaded to the GPU when drawn.
    with PerfTrek(trek_bin, work, "memory", seed, force_active=True, test_display=IS_MAC) as t:
        t.wait_line("startup")

        def phase(name, settle=4):
            time.sleep(settle)
            foot, parts = t.footprint_parts()
            rss, _ = t.sample()
            # What Trek itself counts: transcripts in memory, parsed answers, pictures, snapshots.
            t.batch([f"perf mem {name}"], timeout=60)
            held = {k: int(v) for k, v in t.wait_line("mem", label=name).items() if k not in ("kind", "label")}
            out["phases"][name] = {"footprint_mb": foot and round(foot), "rss_mb": round(rss), "largest_mb": parts, "held": held}
            say(f"memory, {name}: footprint {foot and round(foot)} MB, RSS {round(rss)} MB; {', '.join(f'{k} {v}' for k, v in parts.items())}")
            say(f"        {' '.join(f'{k}={v}' for k, v in held.items())}")

        # There and back through a transcript, a screenful a frame: every row is drawn once.
        def read(title, steps):
            t.batch([f"perf open {title}", "wait 400", f"perf scroll @center -600 {steps} mem-up",
                     f"perf scroll @center 600 {steps} mem-down", "wait 200"], timeout=600)

        phase("idle", a.settle)
        for title in heavy_titles:
            t.batch([f"perf open {title}", "wait 400"], timeout=120)
        phase("long_threads_opened")
        for title in heavy_titles:
            read(title, a.mem_scroll_steps)
        phase("long_threads_read")
        for title in picture_titles:
            t.batch([f"perf open {title}", "wait 1500"], timeout=120)
        phase("picture_threads_opened")
        for title in picture_titles:
            read(title, 12)
        phase("picture_threads_read")
        read("Artifact thread #00", 6)
        phase("artifact_thread_read")
        # Round the threads again, as someone going between them does: how long each takes to show.
        before = len(t.lines())
        for _ in range(a.mem_rounds):
            for title in heavy_titles + picture_titles:
                t.batch([f"perf open {title}", "wait 250"], timeout=120)
        switches = sorted(float(l["painted"]) for l in t.lines()[before:] if l["kind"] == "open")
        out["switches"] = len(switches)
        out["switch_painted_p50_ms"] = median(switches)
        out["switch_painted_p95_ms"] = switches[int((len(switches) - 1) * 0.95)] if switches else None
        say(f"memory, switching {len(switches)} times: shown in {out['switch_painted_p50_ms']} ms (median), {out['switch_painted_p95_ms']} ms (p95)")
        phase("threads_switched")
        # Back up a picture thread seen a while ago: its frames, and whether pictures were read again.
        before = len(t.lines())
        t.batch([f"perf open {picture_titles[0]}", "wait 400", "perf scroll @center -600 12 back-up", "wait 400",
                 "perf scroll @center 600 12 back-down", "wait 200"], timeout=120)
        s = [l for l in t.lines()[before:] if l["kind"] == "scroll" and l.get("label") == "back-up"][-1]
        out["scroll_back_frame_p50_ms"], out["scroll_back_frame_p95_ms"] = float(s["frame_p50"]), float(s["frame_p95"])
        phase("scrolled_back")
        loads = [out["phases"][n]["held"].get("picture_loads") for n in ("threads_switched", "scrolled_back")]
        out["pictures_read_again_scrolling_back"] = None if None in loads else loads[1] - loads[0]
        # A streamed answer on top of it all, then nothing on screen but a new thread.
        if a.mem_stream_secs:
            t.batch(["pace 1", f"route project:{seed}/projects/atlas-api", f"send mock:stream {a.mem_stream_secs}s",
                     f"wait idle {(a.mem_stream_secs + 120) * 1000}", "wait 500"], timeout=a.mem_stream_secs + 180)
            phase("answer_streamed")
        t.batch(["route draft", "wait 500"], timeout=60)
        phase("at_rest", a.settle)
        # Left alone: pictures of threads no longer shown go some minutes after they left the screen.
        if a.mem_idle_secs:
            phase("left_alone", a.mem_idle_secs)
    rest, idle = out["phases"]["at_rest"]["footprint_mb"], out["phases"]["idle"]["footprint_mb"]
    out["peak_mb"] = max(ph["footprint_mb"] or 0 for ph in out["phases"].values())
    out["kept_mb"] = rest - idle if rest is not None and idle is not None else None
    out["limit_mb"] = a.mem_limit
    out["within_limit"] = out["kept_mb"] is not None and out["kept_mb"] <= a.mem_limit
    say(f"memory: peak {out['peak_mb']} MB; {out['kept_mb']} MB kept over idle with nothing on screen (limit {a.mem_limit} MB: {'ok' if out['within_limit'] else 'OVER'})")
    return out


def cmd_perf(a):
    """Trek's launch, memory, CPU, long-thread and checkpoint numbers, measured on this machine (docs/PERFORMANCE.md)."""
    what = list(a.what) or list(PERF_WHAT)
    unknown = [w for w in what if w not in PERF_WHAT]
    if unknown:
        raise CliError(f"unknown measurement {unknown[0]} (one of: {' '.join(PERF_WHAT)})")
    a.thread_counts = [int(n) for n in a.threads.split(",")]
    target = Path(os.environ.get("CARGO_TARGET_DIR") or ROOT / "target")
    builds = []
    if not a.bin:
        builds.append(["cargo", "build", "--release", "-p", "trek-app", "--features", "shots", "--locked"])
    if not a.tools:
        builds.append(["cargo", "build", "--release", "-p", "trek-core", "--example", "perf_seed", "--example", "perf_checkpoint", "--locked"])
    if a.dry_run:
        return {"what": what, "builds": [shlex.join(b) for b in builds], "threads": a.thread_counts, "runs": a.runs,
                "_text": [f"would build: {shlex.join(b)}" for b in builds] + [f"would measure: {' '.join(what)}"]}
    for cmd in builds:
        rc, out = run(cmd, cwd=str(ROOT), timeout=a.timeout)
        if rc != 0:
            raise CliError(f"{shlex.join(cmd)} failed: {out.strip()[-400:]}")
    if a.bin and not Path(a.bin).exists():
        raise CliError(f"no Trek at {a.bin}")
    work = Path(tempfile.mkdtemp(prefix="trek-perf-"))
    # Copied out: another build in this target folder may replace them mid-run.
    trek_bin = work / "trek"
    shutil.copy2(a.bin or target / "release" / "trek", trek_bin)
    tools = work / "tools"
    tools.mkdir()
    for tool in ("perf_seed", "perf_checkpoint"):
        src = Path(a.tools or target / "release" / "examples") / tool
        if src.exists():
            shutil.copy2(src, tools / tool)
    seed_bin = tools / "perf_seed"
    say = (lambda s: print(s, file=sys.stderr, flush=True)) if getattr(a, "json", False) else (lambda s: print(s, flush=True))
    results = {"date": time.strftime("%Y-%m-%d %H:%M"), "git": git("rev-parse", "--short", "HEAD"),
               "machine": {"model": out_of(["sysctl", "-n", "hw.model"]), "cpu": out_of(["sysctl", "-n", "machdep.cpu.brand_string"]),
                           "cores": out_of(["sysctl", "-n", "hw.ncpu"]), "memory_gb": round(int(out_of(["sysctl", "-n", "hw.memsize"]) or 0) / 2**30),
                           "macos": out_of(["sw_vers", "-productVersion"]), "load": os.getloadavg()[0]},
               "binary": {"arch": out_of(["lipo", "-archs", str(trek_bin)]), "mb": round(trek_bin.stat().st_size / 2**20)}}
    measure = {"launch": perf_launch, "idle": perf_idle, "stream": perf_stream, "long": perf_long, "checkpoint": perf_checkpoint,
               "memory": perf_memory}
    say(f"Trek {results['binary']['arch']}, {results['binary']['mb']} MB, load {results['machine']['load']:.0f} on {results['machine']['cores']} cores, in {work}")
    try:
        for w in what:
            results[w] = measure[w](a, trek_bin, seed_bin, work, say)
    finally:
        if a.keep:
            say(f"kept {work}")
        else:
            shutil.rmtree(work, ignore_errors=True)
    results["load_after"] = os.getloadavg()[0]
    if a.out:
        Path(a.out).parent.mkdir(parents=True, exist_ok=True)
        Path(a.out).write_text(json.dumps(results, indent=2) + "\n")
    # The guard: a cache that has lost its budget shows here long before anyone feels it.
    memory = results.get("memory")
    if memory and not memory["within_limit"]:
        raise CliError(f"memory: the session left {memory['kept_mb']} MB over idle, more than the {memory['limit_mb']} MB allowed (docs/PERFORMANCE.md, \"Memory over a session\")")
    return {**results, "_text": [f"load {results['machine']['load']:.0f} before, {results['load_after']:.0f} after"] + ([f"wrote {a.out}"] if a.out else [])}


# ---------------------------------------------------------------- CLI

COMMANDS = {}


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="machine-readable JSON (one object)")
    common.add_argument("--offline", action="store_true", default=argparse.SUPPRESS, help="no gh/network or device calls")
    common.add_argument("--fresh", action="store_true", default=argparse.SUPPRESS, help="ignore the 10-min du size cache")
    p = argparse.ArgumentParser(prog="agent-cli", description=__doc__.strip().splitlines()[0],
                                epilog="Use agent-cli first; prefer it over re-reading files or guessing commands.",
                                parents=[common])
    p.add_argument("--selftest", action="store_true", help="run every subcommand with --json --offline and check it parses")
    p.add_argument("--online", action="store_true", help="with --selftest: allow gh/network calls")
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    def add(name, fn, aliases=(), **kw):
        doc = fn.__doc__.strip()
        sp = sub.add_parser(name, help=doc, description=doc, parents=[common], aliases=list(aliases), **kw)
        sp.set_defaults(fn=fn)
        COMMANDS[name] = sp
        return sp

    s = add("status", cmd_status, epilog="Replaces: git status/log/branch, git rev-list origin/main, gh run list, ps|grep Trek, df -h, du -sh.")
    s.add_argument("--fetch", action="store_true", help="git fetch origin first (otherwise uses the last fetch)")
    s = add("ci", cmd_ci, epilog="Examples: agent-cli ci latest; agent-cli ci latest --workflow release.yml; agent-cli ci 41225286016")
    s.add_argument("run", nargs="?", default="latest", help="run id, or 'latest' (default)")
    s.add_argument("--workflow", help="with latest: ci.yml, release.yml, ...")
    s.add_argument("--branch", help="with latest: branch name")
    s.add_argument("--max", type=int, default=30, help="error lines per failed job (default 30)")
    s.add_argument("--all-jobs", action="store_true", help="list successful and skipped jobs too (default: counted only)")
    add("crates", cmd_crates, epilog="Replaces: ls crates; head crates/*/src/lib.rs; cat Cargo.toml.")
    s = add("feature", cmd_feature, epilog="No name: list features. Example: agent-cli feature video --full")
    s.add_argument("name", nargs="?", help="feature doc name or substring (e.g. browser, phone, git)")
    s.add_argument("--full", action="store_true", help="include the whole doc text")
    s = add("where", cmd_where, epilog="Examples: agent-cli where --defs Workspace; agent-cli where 'fn send_prompt'; agent-cli where -r 'enum (Lucide|Icon)\\b'")
    s.add_argument("query")
    s.add_argument("--defs", action="store_true", help="definitions only (fn/struct/enum/trait/impl/mod/const/type, Swift func/class)")
    s.add_argument("-r", "--regex", action="store_true", help="query is a regex")
    s.add_argument("--all", action="store_true", help="also ios/, script/, docs/, .agents/, .github/")
    s.add_argument("--case", action="store_true", help="case-sensitive (default smart case)")
    s.add_argument("--max", type=int, default=40, help="hits shown (default 40)")
    s = add("logs", cmd_logs, epilog="Replaces: sed 's/\\x1b...//' ~/Library/Logs/Trek/trek-<date>.log | grep -E ... | tail")
    s.add_argument("n", nargs="?", type=int, default=20, help="lines of each section (default 20)")
    s.add_argument("--grep", help="keep only lines containing this (case-insensitive)")
    s.add_argument("--width", type=int, default=220, help="cut lines at this many chars")
    s = add("worktrees", cmd_worktrees, epilog="Replaces: git worktree list; git branch --merged; du -sh <wt>/target.")
    s.add_argument("--fast", action="store_true", help="skip per-worktree git status and du")
    add("disk", cmd_disk, epilog="Prints levers; never deletes anything itself.")
    add("release", cmd_release, epilog="Prints the dispatch line; never dispatches.")
    s = add("merge", cmd_merge, epilog="The way agents merge (AGENTS.md). Refuses, saying what to do, when CI or (for app code) Live hasn't passed on the head. "
            "Examples: agent-cli merge 99 --dry-run; agent-cli merge 99; agent-cli merge 99 -- --squash")
    s.add_argument("number", type=int)
    s.add_argument("--dry-run", action="store_true", help="say whether it may merge; don't merge")
    s.add_argument("merge_args", nargs="*", help="after --: options for gh pr merge (default --merge)")
    s = add("downloads", cmd_downloads, epilog="Replaces: gh api repos/dokyit/Trek/releases | jq '.[].assets[].download_count'. "
            f"PostHog installs need a personal API key (phx_...) in {POSTHOG_KEY_FILE}; project id in {POSTHOG_PROJECT_FILE} "
            "or TREK_POSTHOG_PROJECT (default @current).")
    s.add_argument("n", nargs="?", type=int, default=10, help="versions shown, newest first (default 10)")
    s.add_argument("--all", action="store_true", help="every version")
    s.add_argument("--repo", default="dokyit/Trek", help="owner/name (default dokyit/Trek)")
    s.add_argument("--timeout", type=int, default=60)
    s = add("phone", cmd_phone, epilog="Runs ios/scripts/phone-update.sh --status (read-only).")
    s.add_argument("--timeout", type=int, default=90)
    s = add("memory", cmd_memory, epilog="Examples: agent-cli memory; agent-cli memory release; agent-cli memory disk --list")
    s.add_argument("query", nargs="?")
    s.add_argument("--list", action="store_true", help="with a query: only list matches, no body")
    s = add("tasks", cmd_tasks, epilog="Replaces: until [ -s .../tasks/<id>.output ]; do sleep; done; tail .../tasks/<id>.output")
    s.add_argument("n", nargs="?", type=int, default=12)
    s = add("digest", cmd_digest, epilog="Replaces: grep -E '^(error|warning)' -A8 <log>; grep 'test result'; tail -3. Example: cargo test ... 2>&1 | agent-cli digest -")
    s.add_argument("file", help="log path, or - for stdin")
    s.add_argument("--max", type=int, default=25)
    for name, fn in (("test", cmd_test), ("check", cmd_check)):
        s = add(name, fn)
        s.add_argument("-p", "--crate", default="trek-app", help="crate (default trek-app)")
        s.add_argument("--features", help="cargo features, e.g. shots")
        s.add_argument("--dry-run", action="store_true", help="print the command, run nothing")
        s.add_argument("--timeout", type=int, default=3600)
        s.add_argument("--max", type=int, default=25)
        if name == "test":
            s.add_argument("filter", nargs="?", help="test name filter")
            s.add_argument("--lib", action="store_true", help="only the lib tests")
        else:
            s.add_argument("--clippy", action="store_true", help="cargo clippy instead of check")
            s.add_argument("--tests", action="store_true", help="also check test targets")
    s = add("ios-build", cmd_ios_build, epilog="Replaces: xcodebuild build -project ios/Trek.xcodeproj ... | grep -E 'error:|BUILD'")
    s.add_argument("--derived-data", help="default ~/Library/Caches/Trek/ios-dd")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--timeout", type=int, default=1800)
    s.add_argument("--max", type=int, default=25)
    s = add("sims", cmd_sims)
    s.add_argument("n", nargs="?", type=int, default=8, help="non-booted devices shown")
    s = add("dock", cmd_dock, epilog="Replaces: lsappinfo list/info, defaults read com.apple.dock recent-apps. An extra app record names the process that registered as a second Trek.")
    s.add_argument("--clear", action="store_true", help="take stale Trek tiles out of the Dock's recent apps and restart the Dock")
    s = add("perf", cmd_perf, epilog="Isolated Trek only (throwaway data folder, mock agent). Example: agent-cli perf launch idle --runs 5 --out dist/perf/mac.json")
    s.add_argument("what", nargs="*", help=f"some of: {' '.join(PERF_WHAT)} (default all)")
    s.add_argument("--bin", help="a Trek built with --features shots (default: build it, release, in this checkout)")
    s.add_argument("--tools", help="folder holding the perf_seed and perf_checkpoint examples (default: build them)")
    s.add_argument("--threads", default="0,10,100", help="thread counts for launch and idle (default 0,10,100)")
    s.add_argument("--runs", type=int, default=5, help="warm launches and checkpoints; medians are reported (default 5)")
    s.add_argument("--cold-runs", type=int, default=3, help="cold launches (default 3)")
    s.add_argument("--settle", type=int, default=25, help="seconds Trek settles before an idle or stream sample (default 25)")
    s.add_argument("--idle-secs", type=int, default=60, help="seconds of idle CPU (default 60)")
    s.add_argument("--front", action="store_true", help="idle also on screen: a small Trek window above your others for --front-secs, without the keyboard")
    s.add_argument("--front-secs", type=int, default=20, help="seconds of on-screen idle (default 20)")
    s.add_argument("--stream-secs", type=int, default=120, help="seconds of the streamed answer (default 120)")
    s.add_argument("--long-items", type=int, default=10000, help="items in the long thread (default 10000)")
    s.add_argument("--big-repo-files", type=int, default=100000, help="files in the repo checkpoints are also timed on (default 100000)")
    s.add_argument("--big-repo", help="time checkpoints on this repo instead of making one")
    s.add_argument("--mem-heavy", type=int, default=8, help="memory: threads of long answers (default 8, 200 items each)")
    s.add_argument("--mem-picture-threads", type=int, default=3, help="memory: threads of screenshots, 15 pictures each (default 3)")
    s.add_argument("--mem-scroll-steps", type=int, default=450, help="memory: screenfuls scrolled up each long thread, and back (default 450)")
    s.add_argument("--mem-rounds", type=int, default=3, help="memory: times round all the threads (default 3)")
    s.add_argument("--mem-stream-secs", type=int, default=60, help="memory: seconds of a streamed answer at the end, 0 for none (default 60)")
    s.add_argument("--mem-idle-secs", type=int, default=0, help="memory: seconds left alone at the end, for what goes when nothing is shown (default 0: skipped; 540 covers it)")
    s.add_argument("--mem-limit", type=int, default=600, help="memory: MB the session may leave over idle with nothing on screen; more fails the run (default 600: it leaves 190 to 340, and left 3,560 before its caches had budgets)")
    s.add_argument("--out", help="write the results here as JSON too")
    s.add_argument("--keep", action="store_true", help="keep the scratch folder")
    s.add_argument("--dry-run", action="store_true", help="print what would be built and measured, run nothing")
    s.add_argument("--timeout", type=int, default=3600)
    s = add("symbolicate", cmd_symbolicate, epilog="Examples: agent-cli symbolicate ~/Library/Logs/Trek/freeze-2026-11-21-171439.txt; "
            "agent-cli symbolicate /Library/Logs/DiagnosticReports/trek_….cpu_resource.diag; agent-cli symbolicate panic.log --version 0.4.64. "
            f"Symbols come from the release (Trek-<v>-<platform>.dSYM.zip), else the release run's 90-day artifact, and are kept in {SYMBOLS_CACHE}. "
            "Replaces: gh release download …; unzip; dwarfdump --uuid; atos -o … -arch … -offset …; c++filt.")
    s.add_argument("file", help="a freeze-*.txt, a Trek log or crash-reports/panic-*.json with a backtrace, a .ips, or a .diag/spin/hang report")
    s.add_argument("--version", help="Trek's version, when the file doesn't say (it usually does)")
    s.add_argument("--arch", help="arm64 or x86_64, when the file doesn't say")
    s.add_argument("--symbols", help="a .dSYM, a folder of them, or a .dSYM.zip, instead of fetching the release's")
    s.add_argument("--repo", help="owner/name (default: origin's)")
    s.add_argument("--out", help="write the named file here instead of printing it")
    s.add_argument("--parse-only", action="store_true", help="say what the file is from and which symbols it needs; fetch nothing")
    return p


SELFTEST_ARGS = {
    "dock": [],
    "perf": ["--dry-run"],
    "merge": ["1", "--dry-run"],
    "status": [], "ci": ["latest"], "crates": [], "feature": ["video"], "where": ["--defs", "main", "--max", "3"],
    "logs": ["5"], "worktrees": ["--fast"], "disk": [], "release": [], "downloads": ["3"], "phone": [], "memory": [], "tasks": ["3"],
    "digest": ["-"], "test": ["--dry-run", "-p", "trek-time"], "check": ["--dry-run", "-p", "trek-time"],
    "ios-build": ["--dry-run"], "sims": ["2"],
    "symbolicate": ["script/tests/fixtures/symbolicate/freeze.txt", "--parse-only"],
}
DIGEST_SAMPLE = ("2026-10-31T10:00:00.0000000Z \x1b[31merror[E0425]\x1b[0m: cannot find value `x`\n"
                 "  --> crates/a/src/lib.rs:3:5\nwarning: unused import\n"
                 "test foo::bar ... FAILED\ntest result: FAILED. 3 passed; 1 failed; 0 ignored\n")


def selftest(as_json, online):
    me = os.path.abspath(__file__)
    results = []
    missing = sorted(set(COMMANDS) - set(SELFTEST_ARGS))
    for name in COMMANDS:
        args = SELFTEST_ARGS.get(name, [])
        for variant in (["--help"], args + ["--json"] + ([] if online else ["--offline"])):
            t0 = time.time()
            try:
                p = subprocess.run([sys.executable, "-I", me, name, *variant], cwd=str(ROOT), stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, text=True, timeout=180,
                                   input=DIGEST_SAMPLE if name == "digest" else "")
                rc, out, err = p.returncode, p.stdout, p.stderr
            except subprocess.TimeoutExpired:
                rc, out, err = 124, "", "timeout"
            ok, why = rc == 0, err.strip()[-200:]
            if ok and "--json" in variant:
                try:
                    obj = json.loads(out)
                    ok = isinstance(obj, dict)
                    why = "" if ok else "not an object"
                    if ok and name == "digest":
                        ok = obj.get("tests_failed") == 1 and obj.get("failed_tests") == ["foo::bar"] and \
                            any("E0425" in e and "-->" in e for e in obj.get("errors", []))
                        why = "" if ok else f"digest fixture mismatch: {obj}"
                except ValueError as e:
                    ok, why = False, f"bad JSON: {e}"
            elif ok:
                ok = "usage:" in out
            results.append({"cmd": f"{name} {' '.join(variant)}", "ok": ok, "s": round(time.time() - t0, 2), **({"why": why} if not ok else {})})
    unit = extract_errors(DIGEST_SAMPLE)
    results.append({"cmd": "unit extract_errors", "ok": bool(unit) and unit[0].startswith("error[E0425]") and "\x1b" not in unit[0]})
    kinds = [asset_kind(n) for n in ("stable.json", "Trek-0.4.40-darwin-aarch64.dmg", "Trek-0.4.40-darwin-aarch64.app.tar.gz",
                                     "Trek-0.4.40-darwin-x86_64.app.tar.gz", "Trek-Setup-x86_64.exe",
                                     "Trek-0.4.40-windows-x86_64.zip", "Trek-0.4.40-windows-x86_64.zip.minisig",
                                     "Trek-0.4.40-darwin-aarch64.dSYM.zip", "Trek-0.4.40-windows-x86_64.pdb.zip")]
    results.append({"cmd": "unit asset_kind", "ok": kinds == [("manifest", None), ("installer", "mac-arm64"), ("update", "mac-arm64"),
                                                              ("update", "mac-intel"), ("installer", "windows-x64"),
                                                              ("update", "windows-x64"), (None, None), (None, None), (None, None)]})
    results.extend(symbolicate_units())
    if missing:
        results.append({"cmd": "selftest covers " + ",".join(missing), "ok": False})
    passed = all(r["ok"] for r in results)
    data = {"passed": passed, "checks": len(results), "failed": [r for r in results if not r["ok"]],
            "_text": [f"{'ok  ' if r['ok'] else 'FAIL'} {r['cmd']}" + (f"  {r.get('why', '')}" if not r["ok"] else "") for r in results]
            + [f"selftest {'passed' if passed else 'FAILED'} ({len(results)} checks)"]}
    emit(data, as_json)
    return 0 if passed else 1


def main(argv):
    global OFFLINE, FRESH
    p = build_parser()
    a = p.parse_args(argv)
    as_json = getattr(a, "json", False)
    OFFLINE = getattr(a, "offline", False) or os.environ.get("AGENT_CLI_OFFLINE") == "1"
    FRESH = getattr(a, "fresh", False)
    if a.selftest:
        return selftest(as_json, online=a.online and not OFFLINE)
    if not getattr(a, "fn", None):
        p.print_help()
        return 0
    try:
        data = a.fn(a)
    except CliError as e:
        emit({"ok": False, "error": str(e), "_text": [f"error {e}"]}, as_json)
        return 2
    emit(data, as_json)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
