{
  "type": "column",
  "gap": 14,
  "pad": [6, 10, 12, 10],
  "children": [
    {
      "type": "column",
      "gap": 6,
      "children": [
        { "type": "row", "gap": 7, "align": "center", "children": [
          { "type": "icon", "name": "hand", "fg": "warning", "size": 13 },
          { "type": "text", "text": "Needs you", "size": "label", "weight": "medium" }
        ]},
        { "type": "each", "of": "threads", "where": { "state": "needs-you|failed" }, "as": "t", "limit": 12, "gap": 4,
          "item": {
            "type": "column", "gap": 2, "pad": [7, 10], "radius": "control", "bg": "warning/12", "border": "warning/35",
            "on": "open:{t.id}", "tooltip": "{t.title}",
            "children": [
              { "type": "text", "text": "{t.title}", "size": "body", "truncate": true },
              { "type": "row", "gap": 6, "children": [
                { "type": "text", "text": "{t.project|or:No project} · {t.agent}", "size": "meta", "fg": "muted", "truncate": true, "grow": true },
                { "type": "text", "text": "{t.updated|ago}", "size": "meta", "fg": "muted" }
              ]}
            ]
          },
          "empty": { "type": "text", "text": "Nothing waits on you.", "size": "meta", "fg": "muted/70", "pad": [2, 2] }
        }
      ]
    },
    {
      "type": "column",
      "gap": 6,
      "children": [
        { "type": "row", "gap": 7, "align": "center", "children": [
          { "type": "icon", "name": "footprints", "fg": "accent", "size": 13 },
          { "type": "text", "text": "On the trail", "size": "label", "weight": "medium" }
        ]},
        { "type": "each", "of": "threads", "where": { "state": "working" }, "as": "t", "limit": 12, "gap": 4,
          "item": {
            "type": "column", "gap": 2, "pad": [7, 10], "radius": "control", "bg": "surface", "border": "accent/45",
            "on": "open:{t.id}", "tooltip": "{t.title}",
            "children": [
              { "type": "text", "text": "{t.title}", "size": "body", "truncate": true },
              { "type": "row", "gap": 6, "children": [
                { "type": "text", "text": "{t.project|or:No project} · {t.agent}", "size": "meta", "fg": "muted", "truncate": true, "grow": true },
                { "type": "text", "text": "{t.updated|ago}", "size": "meta", "fg": "muted" }
              ]}
            ]
          },
          "empty": { "type": "text", "text": "No agent is walking.", "size": "meta", "fg": "muted/70", "pad": [2, 2] }
        }
      ]
    },
    {
      "type": "column",
      "gap": 6,
      "children": [
        { "type": "row", "gap": 7, "align": "center", "children": [
          { "type": "icon", "name": "tent", "fg": "muted", "size": 13 },
          { "type": "text", "text": "At camp", "size": "label", "weight": "medium" }
        ]},
        { "type": "each", "of": "threads", "where": { "state": "idle" }, "as": "t", "limit": 10, "gap": 4,
          "item": {
            "type": "column", "gap": 2, "pad": [7, 10], "radius": "control", "bg": "surface",
            "on": "open:{t.id}", "tooltip": "{t.title}",
            "children": [
              { "type": "text", "text": "{t.title}", "size": "body", "truncate": true },
              { "type": "row", "gap": 6, "children": [
                { "type": "text", "text": "{t.project|or:No project} · {t.agent}", "size": "meta", "fg": "muted", "truncate": true, "grow": true },
                { "type": "text", "text": "{t.updated|ago}", "size": "meta", "fg": "muted" }
              ]}
            ]
          },
          "empty": { "type": "text", "text": "The camp is empty.", "size": "meta", "fg": "muted/70", "pad": [2, 2] }
        }
      ]
    },
    {
      "type": "column",
      "gap": 6,
      "children": [
        { "type": "row", "gap": 7, "align": "center", "children": [
          { "type": "icon", "name": "mountain", "fg": "positive", "size": 13 },
          { "type": "text", "text": "Summit", "size": "label", "weight": "medium" }
        ]},
        { "type": "each", "of": "threads", "where": { "state": "done" }, "as": "t", "limit": 6, "gap": 2,
          "item": {
            "type": "row", "gap": 6, "pad": [4, 10], "radius": "control", "on": "open:{t.id}", "tooltip": "{t.title}",
            "children": [
              { "type": "text", "text": "{t.title}", "size": "label", "fg": "muted", "truncate": true, "grow": true },
              { "type": "text", "text": "{t.updated|ago}", "size": "meta", "fg": "muted/70" }
            ]
          },
          "empty": { "type": "text", "text": "Settle a thread and it lands here.", "size": "meta", "fg": "muted/70", "pad": [2, 2] }
        }
      ]
    },
    { "type": "divider" },
    { "type": "when", "value": "state.list", "equals": "on",
      "then": { "type": "column", "gap": 6, "children": [
        { "type": "button", "text": "Hide Trek's own list", "on": "set:list=off" },
        { "type": "trek:thread-list" }
      ]},
      "else": { "type": "button", "text": "Show Trek's own list", "on": "set:list=on" }
    }
  ]
}
