{
  "type": "row",
  "gap": 10,
  "align": "center",
  "pad": [6, 8],
  "radius": "card",
  "bg": "surface/60",
  "on": "command:pat",
  "tooltip": "Pat Pip",
  "children": [
    { "type": "when", "value": "state.mood", "equals": "whistling",
      "then": { "type": "image", "src": "art/whistling.svg", "width": 36, "height": 36 },
      "else": { "type": "when", "value": "state.mood", "equals": "working",
        "then": { "type": "image", "src": "art/working.svg", "width": 36, "height": 36 },
        "else": { "type": "when", "value": "state.mood", "equals": "cheering",
          "then": { "type": "image", "src": "art/cheering.svg", "width": 36, "height": 36 },
          "else": { "type": "image", "src": "art/asleep.svg", "width": 36, "height": 36 }
        }
      }
    },
    { "type": "column", "gap": 1, "grow": true, "children": [
      { "type": "text", "text": "Pip", "size": "label", "weight": "medium" },
      { "type": "text", "text": "{state.line|or:Napping: nothing's running}", "size": "meta", "fg": "muted", "truncate": true }
    ]},
    { "type": "when", "value": "state.mood", "equals": "whistling",
      "then": { "type": "row", "pad": [1, 7], "radius": "full", "bg": "warning/20", "children": [
        { "type": "text", "text": "{state.waiting}", "size": "meta", "fg": "warning", "weight": "semibold" }
      ]}
    }
  ]
}
