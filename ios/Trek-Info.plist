<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Phase 1a talks plain ws:// to the Mac on the LAN or a tailnet (WireGuard-encrypted).
	     Phase 1b moves to wss:// with a pinned per-Mac certificate and drops arbitrary loads. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.trek.TrekMobile.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trek</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
