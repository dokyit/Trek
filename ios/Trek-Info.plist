<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac serves wss:// with a self-signed certificate the app pins (TrekClient's
	     PinningDelegate checks SHA-256 of its DER against the paired fingerprint).
	     NSAllowsLocalNetworking: LAN IP addresses, `.local` and bare host names. Not tailnet IP
	     addresses: ATS refuses the certificate there, so the app dials them with Network.framework
	     (`Address.needsNetworkLink`), which leaves it to the pin.
	     ts.net: Tailscale MagicDNS names. ATS refuses a self-signed certificate on a fully
	     qualified name even after the pin accepted it; this exception lets the pin decide.
	     Nothing else is exempt (no NSAllowsArbitraryLoads). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Trek connects to Trek on your Mac, on your local network, to show your agents and relay your answers.</string>
	<!-- Trek on the Mac announces itself as _trek._tcp, so a paired Mac whose address changed is
	     found again (MacFinder). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_trek._tcp</string>
	</array>
	<key>NSFaceIDUsageDescription</key>
	<string>Trek asks for Face ID before letting an agent skip approvals for the rest of a session.</string>
	<!-- Dictation in the composer: the mic hears the message, Speech Recognition turns it into
	     words on this iPhone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Trek listens while you hold a message to say, so you can speak a follow-up instead of typing it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Trek turns what you say into the words of your message, on this iPhone when it can.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.trek.TrekMobile.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trek</string>
			</array>
		</dict>
	</array>
	<!-- The Mac's faces (Resources/Fonts, SIL Open Font License 1.1): Inter for the interface,
	     JetBrains Mono NL for code. -->
	<key>UIAppFonts</key>
	<array>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>Inter-Italic.ttf</string>
		<string>JetBrainsMonoNL-Regular.ttf</string>
		<string>JetBrainsMonoNL-Medium.ttf</string>
		<string>JetBrainsMonoNL-SemiBold.ttf</string>
		<string>JetBrainsMonoNL-Bold.ttf</string>
		<string>JetBrainsMonoNL-Italic.ttf</string>
	</array>
</dict>
</plist>
