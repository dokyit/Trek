#!/usr/bin/env python3
"""Safe, checkout-aware driver for Trek's isolated shots build."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import platform
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable, Optional


SETTINGS = """[general]
default_agent = "direct:mock"

[onboarding]
completed = true

[import]
claude_code = false
codex = false
opencode = false

[notifications]
mode = "off"
dock_badge = false
menu_bar_icon = false

[updates]
auto_check = false
auto_download = false
"""

TOOLS = {"git", "explorer", "terminal", "browser", "sidechat", "simulator"}
BASIC_ROUTES = {"draft", "no-project", "basecamp", "notes", "appearance", "first"}
CONTROL_VERBS = {"range", "settled", "glass", "tint", "theme", "pace", "wait", "new", "diff", "tools"}


class CliError(RuntimeError):
    def __init__(self, message: str, *, hint: Optional[str] = None, details: Any = None):
        super().__init__(message)
        self.hint = hint
        self.details = details


def project_root() -> Path:
    proc = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if proc.returncode:
        raise CliError(
            "This command is not running inside a Git checkout.",
            hint="cd to the Trek checkout or worktree, then run the CLI again",
        )
    return Path(proc.stdout.strip()).resolve()


def runtime_dir(root: Path) -> Path:
    key = hashlib.sha256(str(root).encode()).hexdigest()[:12]
    base = Path(os.environ.get("TREK_VERIFY_HOME", tempfile.gettempdir()))
    return base / f"trek-verify-{os.getuid()}-{key}"


class Driver:
    def __init__(self, root: Path):
        self.root = root
        self.home = runtime_dir(root)
        self.shot_dir = self.home / "shot"
        self.data_dir = self.home / "data"
        self.log_path = self.home / "trek.log"
        self.state_path = self.home / "state.json"
        # The lock must survive `reset`, otherwise another process can keep a lock on the deleted
        # inode while a new process locks a replacement and enters the same profile concurrently.
        self.lock_path = self.home.with_name(f".{self.home.name}.lock")
        self.pending_path = self.home / "pending.json"
        self.provenance_path = self.root / "target" / ".trek-verify-shots.json"

    @contextmanager
    def locked(self):
        self.lock_path.parent.mkdir(parents=True, exist_ok=True)
        with self.lock_path.open("a+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            yield

    def state(self) -> dict[str, Any]:
        try:
            state = json.loads(self.state_path.read_text())
        except (OSError, json.JSONDecodeError):
            return {}
        if state.get("root") != str(self.root) or state.get("isolated") is not True:
            return {}
        return state

    @staticmethod
    def pid_alive(pid: Any) -> bool:
        try:
            os.kill(int(pid), 0)
            return True
        except (OSError, TypeError, ValueError):
            return False

    @staticmethod
    def process_signature(pid: Any) -> str:
        if not Driver.pid_alive(pid):
            return ""
        try:
            proc = subprocess.run(
                ["ps", "-p", str(int(pid)), "-o", "lstart=", "-o", "command="],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                timeout=5,
            )
        except (OSError, TypeError, ValueError, subprocess.TimeoutExpired):
            return ""
        return proc.stdout.strip() if proc.returncode == 0 else ""

    def state_alive(self, state: dict[str, Any]) -> bool:
        signature = state.get("process_signature")
        return bool(signature and signature == self.process_signature(state.get("pid")))

    def running_state(self) -> dict[str, Any]:
        state = self.state()
        if not state or not self.state_alive(state):
            raise CliError(
                "The isolated Trek app is not running.",
                hint="run ./.agents/skills/verify-trek/scripts/trek-dev start",
            )
        return state

    def status(self) -> dict[str, Any]:
        state = self.state()
        running = bool(state and self.state_alive(state))
        return {
            "running": running,
            "pid": state.get("pid") if running else None,
            "isolated": bool(state.get("isolated")) if running else False,
            "root": str(self.root),
            "runtime_dir": str(self.home),
            "data_dir": str(self.data_dir),
            "log": str(self.log_path),
            "started_at": state.get("started_at") if running else None,
        }

    def prerequisites(self) -> dict[str, Any]:
        def probe(command: list[str]) -> tuple[bool, str]:
            try:
                proc = subprocess.run(command, cwd=self.root, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
                return proc.returncode == 0, proc.stdout.strip()
            except (OSError, subprocess.TimeoutExpired) as exc:
                return False, str(exc)

        rust_ok, rust = probe(["rustc", "--version"])
        xcode_ok, xcode = probe(["xcodebuild", "-version"])
        metal_ok, metal = probe(["xcrun", "-sdk", "macosx", "metal", "--version"])
        return {
            "macos": platform.system() == "Darwin",
            "architecture": platform.machine(),
            "rust": {"ok": rust_ok, "detail": rust},
            "xcode": {"ok": xcode_ok, "detail": xcode},
            "metal": {"ok": metal_ok, "detail": metal},
        }

    def build(self) -> dict[str, Any]:
        prereqs = self.prerequisites()
        if not prereqs["macos"]:
            raise CliError("Trek development builds require macOS 13 or later.")
        if not prereqs["rust"]["ok"]:
            raise CliError("Rust is not available.", hint="install stable Rust with rustup")
        if not prereqs["xcode"]["ok"]:
            raise CliError("Full Xcode is not available.", hint="install Xcode, select it with xcode-select, and retry")
        if not prereqs["metal"]["ok"]:
            raise CliError(
                "Xcode's Metal Toolchain is not installed.",
                hint="run xcodebuild -downloadComponent MetalToolchain once, then retry",
                details=prereqs["metal"]["detail"],
            )
        started = time.monotonic()
        env = os.environ.copy()
        env["CARGO_TARGET_DIR"] = str(self.root / "target")
        proc = subprocess.run(
            ["cargo", "build", "--locked", "-p", "trek-app", "--features", "shots", "--message-format", "json-render-diagnostics"],
            cwd=self.root,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        if proc.returncode:
            raise CliError("The Trek shots build failed.", hint="inspect the captured build output", details=tail_text(proc.stdout, 80))
        binary = cargo_binary(proc.stdout)
        if binary is None:
            raise CliError("Cargo reported success but did not report the Trek executable artifact.")
        binary = binary.resolve()
        try:
            binary.relative_to((self.root / "target").resolve())
        except ValueError:
            raise CliError("Cargo reported a Trek executable outside this checkout's controlled target directory.", details=str(binary))
        if not os.access(binary, os.X_OK):
            raise CliError("Cargo reported success but its Trek executable is missing or not executable.", details=str(binary))
        provenance = {
            "root": str(self.root),
            "binary": str(binary),
            "sha256": file_sha256(binary),
            "feature": "shots",
            "built_at": datetime.now(timezone.utc).isoformat(),
        }
        self.provenance_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.provenance_path.with_name(f"{self.provenance_path.name}.{os.getpid()}.tmp")
        tmp.write_text(json.dumps(provenance, indent=2) + "\n")
        os.replace(tmp, self.provenance_path)
        return {"binary": str(binary), "seconds": round(time.monotonic() - started, 2)}

    def verified_binary(self) -> Path:
        try:
            provenance = json.loads(self.provenance_path.read_text())
        except (OSError, json.JSONDecodeError):
            provenance = {}
        expected = provenance.get("sha256")
        binary_value = provenance.get("binary")
        if provenance.get("root") != str(self.root) or provenance.get("feature") != "shots" or not expected or not binary_value:
            raise CliError(
                "The existing Trek binary has no verified shots-build provenance.",
                hint="rerun without --no-build before launching isolated verification",
            )
        binary = Path(binary_value).resolve()
        try:
            binary.relative_to((self.root / "target").resolve())
        except ValueError:
            raise CliError("The recorded shots executable is outside this checkout's controlled target directory.", details=str(binary))
        if not os.access(binary, os.X_OK):
            raise CliError("The recorded shots executable is missing or not executable.", hint="rerun without --no-build", details=str(binary))
        if file_sha256(binary) != expected:
            raise CliError(
                "The Trek executable changed after the last verified shots build.",
                hint="rerun without --no-build; an ordinary build may have replaced the binary",
            )
        return binary

    def seed(self) -> None:
        self.shot_dir.mkdir(parents=True, exist_ok=True)
        self.data_dir.mkdir(parents=True, exist_ok=True)
        (self.data_dir / "settings.toml").write_text(SETTINGS)
        (self.home / "ISOLATED_MOCK_ONLY").write_text(
            "Created by verify-trek. TREK_SHOT_DIR isolates Keychain/data and only permits the mock agent.\n"
        )

    def start(self, *, build: bool, size: str) -> dict[str, Any]:
        with self.locked():
            return self._start(build=build, size=size)

    def _start(self, *, build: bool, size: str) -> dict[str, Any]:
        current = self.status()
        if current["running"]:
            return {**current, "already_running": True}
        build_result = None
        if build:
            build_result = self.build()
        binary = self.verified_binary()
        self.seed()
        for stale in (self.shot_dir / "cmd", self.shot_dir / "done", self.pending_path):
            stale.unlink(missing_ok=True)
        env = os.environ.copy()
        env.update(
            {
                "TREK_DATA_DIR": str(self.data_dir),
                "TREK_SHOT_DIR": str(self.shot_dir),
                "TREK_MOCK_AGENT": "1",
                "TREK_BACKGROUND": "1",
                "TREK_FORCE_ACTIVE": "1",
                "TREK_WINDOW_SIZE": size,
                "RUST_LOG": "warn,trek=info",
            }
        )
        log = self.log_path.open("a")
        log.write(f"\n=== verify-trek start {datetime.now(timezone.utc).isoformat()} ===\n")
        log.flush()
        proc = subprocess.Popen(
            [str(binary)],
            cwd=self.root,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        log.close()
        state = {
            "root": str(self.root),
            "pid": proc.pid,
            "binary": str(binary),
            "isolated": True,
            "mock_only": True,
            "started_at": datetime.now(timezone.utc).isoformat(),
            "size": size,
        }
        state["process_signature"] = self.process_signature(proc.pid)
        if not state["process_signature"]:
            self.terminate_owned(proc)
            raise CliError("Trek launched, but its process identity could not be verified.")
        self.state_path.write_text(json.dumps(state, indent=2) + "\n")
        try:
            self._batch(["wait 100"], timeout=60)
        except Exception:
            self._end_process(state)
            raise CliError(
                "Trek launched but its verification command loop did not become ready.",
                hint=f"run the logs command; the log is {self.log_path}",
                details=tail_file(self.log_path, 40),
            )
        return {
            **self.status(),
            "already_running": False,
            "build": build_result,
            "safety": "throwaway data folder, imports off, notifications off, mock agent only",
        }

    def batch(self, lines: Iterable[str], *, timeout: float = 90) -> str:
        with self.locked():
            return self._batch(lines, timeout=timeout)

    def _batch(self, lines: Iterable[str], *, timeout: float = 90) -> str:
        state = self.running_state()
        commands = [line.strip() for line in lines if line.strip()]
        if not commands:
            raise CliError("No command was supplied.")
        self.home.mkdir(parents=True, exist_ok=True)
        done = self.shot_dir / "done"
        command_file = self.shot_dir / "cmd"
        if self.pending_path.exists() or command_file.exists():
            raise CliError(
                "A previous verification command has no confirmed completion.",
                hint="run stop, then start, before sending another command",
            )
        done.unlink(missing_ok=True)
        pending = {
            "pid": state["pid"],
            "commands": commands,
            "submitted_at": datetime.now(timezone.utc).isoformat(),
        }
        self.pending_path.write_text(json.dumps(pending, indent=2) + "\n")
        tmp = self.shot_dir / f".cmd.{os.getpid()}.tmp"
        tmp.write_text("\n".join(commands) + "\n")
        os.replace(tmp, command_file)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            result = self._take_done(done)
            if result is not None:
                if result == "ok":
                    return result
                raise CliError("Trek rejected a verification command.", details=result)
            if not self.state_alive(state):
                raise CliError("Trek exited while handling a verification command.", hint="run stop, then start; inspect logs for the cause", details=tail_file(self.log_path, 40))
            time.sleep(0.1)
        # Close the boundary race: consume a completion written on the last tick. Otherwise keep
        # pending.json so no later command can mistake this batch's eventual `done` for its own.
        result = self._take_done(done)
        if result is not None:
            if result == "ok":
                return result
            raise CliError("Trek rejected a verification command.", details=result)
        raise CliError(
            f"Trek did not finish the command within {timeout:g} seconds.",
            hint="run stop, then start; commands remain blocked until the process is recovered",
        )

    def _take_done(self, done: Path) -> Optional[str]:
        if not done.exists():
            return None
        result = done.read_text().strip()
        done.unlink(missing_ok=True)
        self.pending_path.unlink(missing_ok=True)
        return result

    def capture(self, name: str, output: Path) -> dict[str, Any]:
        with self.locked():
            self._batch([f"shot {name}"], timeout=45)
            source = self.shot_dir / f"{name}.png"
            if not source.is_file():
                raise CliError("Trek reported a successful capture but the PNG is missing.", details=str(source))
            output.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, output)
            return {"captured": True, "path": str(output), "bytes": output.stat().st_size}

    def stop(self) -> dict[str, Any]:
        with self.locked():
            return self._stop()

    def _stop(self) -> dict[str, Any]:
        state = self.state()
        if not state or not self.state_alive(state):
            return {"stopped": True, "was_running": False, "runtime_dir": str(self.home)}
        pid = int(state["pid"])
        if self.pending_path.exists():
            self._end_process(state)
        else:
            try:
                self._batch(["quit"], timeout=15)
            except CliError:
                pass
        deadline = time.monotonic() + 10
        while self.state_alive(state) and time.monotonic() < deadline:
            time.sleep(0.1)
        if self.state_alive(state):
            self._end_process(state)
        if self.state_alive(state):
            raise CliError("The isolated Trek process did not exit; its state was preserved.", details={"pid": pid, "runtime_dir": str(self.home)})
        state["stopped_at"] = datetime.now(timezone.utc).isoformat()
        state["pid"] = None
        self.state_path.write_text(json.dumps(state, indent=2) + "\n")
        self.pending_path.unlink(missing_ok=True)
        for stale in (self.shot_dir / "cmd", self.shot_dir / "done"):
            stale.unlink(missing_ok=True)
        return {"stopped": True, "was_running": True, "runtime_dir": str(self.home)}

    @staticmethod
    def signal_process(pid: int, sig: signal.Signals) -> None:
        try:
            os.killpg(pid, sig)
        except OSError:
            try:
                os.kill(pid, sig)
            except OSError:
                return

    @staticmethod
    def terminate_owned(proc: subprocess.Popen) -> None:
        """Reap a child we just spawned, before it has a trusted persisted signature."""
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except OSError:
            proc.terminate()
        try:
            proc.wait(timeout=5)
            return
        except subprocess.TimeoutExpired:
            pass
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            proc.kill()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired as exc:
            raise CliError("A newly launched Trek process could not be reaped.", details={"pid": proc.pid}) from exc

    def _end_process(self, state: dict[str, Any]) -> None:
        pid = int(state["pid"])
        self.signal_process(pid, signal.SIGTERM)
        deadline = time.monotonic() + 5
        while self.state_alive(state) and time.monotonic() < deadline:
            time.sleep(0.1)
        if self.state_alive(state):
            self.signal_process(pid, signal.SIGKILL)
            deadline = time.monotonic() + 5
            while self.state_alive(state) and time.monotonic() < deadline:
                time.sleep(0.1)
        if self.state_alive(state):
            raise CliError("Could not terminate the isolated Trek process; state was preserved.", details={"pid": pid, "runtime_dir": str(self.home)})

    def reset(self) -> dict[str, Any]:
        with self.locked():
            stopped = self._stop()
            if self.home.exists():
                shutil.rmtree(self.home)
            return {"reset": True, "removed": str(self.home), "stopped": stopped["was_running"]}


def tail_text(text: str, lines: int) -> str:
    return "\n".join(text.splitlines()[-lines:])


def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def cargo_binary(output: str) -> Optional[Path]:
    """Return Cargo's reported trek bin artifact, independent of configured build target."""
    found: Optional[Path] = None
    for line in output.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        target = message.get("target", {})
        if (
            message.get("reason") == "compiler-artifact"
            and target.get("name") == "trek"
            and "bin" in target.get("kind", [])
            and message.get("executable")
        ):
            found = Path(message["executable"])
    return found


def tail_file(path: Path, lines: int) -> str:
    try:
        return tail_text(path.read_text(errors="replace"), lines)
    except OSError:
        return ""


def dry_result(command: str, actions: list[str]) -> dict[str, Any]:
    return {"ok": True, "command": command, "dry_run": True, "would": actions}


def route_command(route: str) -> str:
    if "\n" in route or "\r" in route:
        raise CliError("Routes cannot contain line breaks.")
    if route.startswith("tool:"):
        tool = route.split(":", 1)[1]
        if tool not in TOOLS:
            raise CliError(f"Unknown tool {tool!r}.", hint=f"choose one of: {', '.join(sorted(TOOLS))}")
        return f"tools {tool}"
    if route in BASIC_ROUTES or route.startswith(("settings:", "thread:", "title:", "project:")):
        return f"route {route}"
    raise CliError(
        f"Unknown route {route!r}.",
        hint="use draft, no-project, basecamp, notes, first, settings:<page>, tool:<name>, title:<query>, thread:<id>, or project:<path>",
    )


def safe_shot_name(value: str) -> str:
    name = Path(value).stem
    clean = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-.")
    if not clean:
        raise CliError("The screenshot name must contain a letter or number.")
    return clean


def run_check(driver: Driver, *, quick: bool) -> dict[str, Any]:
    steps: list[dict[str, Any]] = []

    def run_step(name: str, command: list[str]) -> None:
        started = time.monotonic()
        env = os.environ.copy()
        env["CARGO_TARGET_DIR"] = str(driver.root / "target")
        proc = subprocess.run(command, cwd=driver.root, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        step = {"name": name, "passed": proc.returncode == 0, "seconds": round(time.monotonic() - started, 2), "command": command}
        if proc.returncode:
            step["output"] = tail_text(proc.stdout, 100)
            steps.append(step)
            raise CliError(f"Check failed at: {name}.", details={"steps": steps})
        steps.append(step)

    with driver.locked():
        scripts = sorted((driver.root / "script").glob("*.sh")) + sorted((driver.root / "script" / "lib").glob("*.sh"))
        for script in scripts:
            run_step(f"shell parses: {script.relative_to(driver.root)}", ["zsh", "-n", str(script)])
        if not quick:
            run_step(
                "workspace tests",
                ["cargo", "test", "--locked", "-p", "trek-core", "-p", "trek-agents", "-p", "trek-app", "-p", "trek-mcp"],
            )
        was_running = driver.status()["running"]
        build = driver.build()
        steps.append({"name": "shots build", "passed": True, "seconds": build["seconds"], "binary": build["binary"]})
        # Smoke exactly the executable just built. Preserve the caller's running/stopped state,
        # but never validate an older process that happened to be open before `check`.
        if was_running:
            driver._stop()
        driver._start(build=False, size="1280x820")
        artifacts = driver.home / "artifacts"
        artifacts.mkdir(parents=True, exist_ok=True)
        shots: list[str] = []
        try:
            for route in ("basecamp", "settings:general"):
                driver._batch([route_command(route), "wait 250"], timeout=30)
                name = f"check-{route.replace(':', '-')}"
                driver._batch([f"shot {name}"], timeout=30)
                source = driver.shot_dir / f"{name}.png"
                target = artifacts / f"{name}.png"
                shutil.copy2(source, target)
                shots.append(str(target))
            steps.append({"name": "isolated UI smoke", "passed": True, "routes": ["basecamp", "settings:general"], "screenshots": shots})
        finally:
            if not was_running:
                driver._stop()
    return {"passed": True, "quick": quick, "steps": steps, "screenshots": shots}


def parser() -> argparse.ArgumentParser:
    epilog = "Output is JSON by default. Add --human anywhere for readable text; --json is accepted explicitly."
    p = argparse.ArgumentParser(
        prog="trek-dev",
        description="Build, drive, capture, and debug an isolated Trek app using only the scripted mock agent.",
        epilog=epilog,
    )
    sub = p.add_subparsers(dest="command", required=True)

    preflight = sub.add_parser("preflight", help="Check macOS, Rust, Xcode, and Metal prerequisites.")
    preflight.epilog = "Example: trek-dev preflight"

    start = sub.add_parser("start", help="Build and launch isolated Trek.")
    start.add_argument("--no-build", action="store_true", help="Use Cargo's last Trek artifact only if its hash matches the verified shots build.")
    start.add_argument("--size", default="1280x820", metavar="WIDTHxHEIGHT", help="Verification window size (default: 1280x820).")
    start.add_argument("--dry-run", action="store_true", help="Describe the build and launch without changing anything.")
    start.epilog = "Example: trek-dev start --size 1280x820"

    status = sub.add_parser("status", help="Report whether the isolated app is running and where its files are.")
    status.epilog = "Example: trek-dev status"

    open_p = sub.add_parser("open", help="Open a route or right-panel tool in the isolated app.")
    open_p.add_argument("route", help="For example basecamp, notes, settings:appearance, tool:git, or title:query.")
    open_p.add_argument("--dry-run", action="store_true", help="Validate and show the command without sending it.")
    open_p.epilog = "Example: trek-dev open settings:appearance"

    project = sub.add_parser("project", help="Add a folder as an isolated project and open a draft in it.")
    project.add_argument("path", help="Project folder; relative paths resolve from this checkout.")
    project.add_argument("--dry-run", action="store_true", help="Describe the action without sending it.")
    project.epilog = "Example: trek-dev project ."

    send = sub.add_parser("send", help="Send a prompt to the scripted mock agent; real agents are unavailable.")
    send.add_argument("prompt", help="Prompt text (quote it if it contains spaces).")
    send.add_argument("--no-wait", action="store_true", help="Return as soon as the prompt is submitted instead of waiting for the turn.")
    send.add_argument("--timeout", type=float, default=90, help="Seconds to wait for the mock turn (default: 90).")
    send.add_argument("--dry-run", action="store_true", help="Describe the mock send without sending it.")
    send.epilog = 'Example: trek-dev send "Show a short streamed answer"'

    control = sub.add_parser("control", help="Run a safe low-level shots command for themes, ranges, waits, or tools.")
    control.add_argument("verb", choices=sorted(CONTROL_VERBS))
    control.add_argument("argument", nargs="*", help="Arguments passed to the command.")
    control.add_argument("--timeout", type=float, default=90, help="Seconds to wait for completion (default: 90).")
    control.add_argument("--dry-run", action="store_true", help="Validate and show the command without sending it.")
    control.epilog = "Examples: trek-dev control theme paper; trek-dev control wait idle 60000"

    shot = sub.add_parser("screenshot", help="Render the Trek window to a PNG without Screen Recording permission.")
    shot.add_argument("name", help="Screenshot name, or output filename when --output is omitted.")
    shot.add_argument("--output", type=Path, help="Destination PNG; defaults to the isolated artifacts folder.")
    shot.add_argument("--dry-run", action="store_true", help="Describe the capture without writing it.")
    shot.epilog = "Example: trek-dev screenshot appearance --output /tmp/trek-appearance.png"

    logs = sub.add_parser("logs", help="Read recent isolated-app logs.")
    logs.add_argument("--lines", type=int, default=80, help="Number of lines to return (default: 80).")
    logs.add_argument("--grep", metavar="TEXT", help="Return only matching lines (case-insensitive).")
    logs.epilog = "Example: trek-dev logs --lines 120 --grep error"

    check = sub.add_parser("check", help="Run CI-equivalent tests, build the shots app, and smoke two UI routes.")
    check.add_argument("--quick", action="store_true", help="Skip Rust tests; still parse scripts, build, launch, route, and capture.")
    check.add_argument("--dry-run", action="store_true", help="List checks without running or writing anything.")
    check.epilog = "Example: trek-dev check  # use --quick only while iterating"

    stop = sub.add_parser("stop", help="Quit the isolated app, preserving its throwaway data and artifacts.")
    stop.add_argument("--dry-run", action="store_true", help="Describe the quit without sending it.")
    stop.epilog = "Example: trek-dev stop"

    reset = sub.add_parser("reset", help="Stop Trek and delete only this checkout's isolated verification state.")
    reset.add_argument("--yes", action="store_true", help="Confirm deletion of the reported isolated runtime directory.")
    reset.add_argument("--dry-run", action="store_true", help="Report what would be removed; delete nothing.")
    reset.epilog = "Examples: trek-dev reset --dry-run; trek-dev reset --yes"

    return p


def human(value: dict[str, Any]) -> str:
    if value.get("ok") is False:
        lines = [f"ERROR: {value.get('error')}"]
        if value.get("hint"):
            lines.append(f"Next: {value['hint']}")
        if value.get("details"):
            details = value["details"]
            lines.append(details if isinstance(details, str) else json.dumps(details, indent=2))
        return "\n".join(lines)
    return json.dumps(value, indent=2)


def main(argv: Optional[list[str]] = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    human_output = "--human" in raw
    raw = [arg for arg in raw if arg not in {"--human", "--json"}]
    args = parser().parse_args(raw)
    try:
        root = project_root()
        driver = Driver(root)
        cmd = args.command
        if cmd == "preflight":
            data = driver.prerequisites()
            data["ready"] = all((data["macos"], data["rust"]["ok"], data["xcode"]["ok"], data["metal"]["ok"]))
        elif cmd == "status":
            data = driver.status()
        elif cmd == "start":
            if not re.fullmatch(r"[0-9]{3,5}x[0-9]{3,5}", args.size):
                raise CliError("--size must look like 1280x820.")
            data = dry_result(cmd, ["build Trek with the shots feature" if not args.no_build else "reuse target/debug/trek", f"launch isolated mock-only app at {driver.home}"]) if args.dry_run else driver.start(build=not args.no_build, size=args.size)
        elif cmd == "open":
            line = route_command(args.route)
            data = dry_result(cmd, [f"send {line!r} to isolated Trek"]) if args.dry_run else (driver.batch([line]) and {"opened": args.route, "command_sent": line})
        elif cmd == "project":
            path = Path(args.path)
            if "\n" in args.path or "\r" in args.path:
                raise CliError("Project paths cannot contain line breaks.")
            if not path.is_absolute():
                path = (root / path).resolve()
            if not path.is_dir():
                raise CliError(f"Project folder does not exist: {path}")
            line = f"project {path}"
            data = dry_result(cmd, [f"add {path} only to the throwaway Trek profile", "open a draft in that project"]) if args.dry_run else (driver.batch([line]) and {"project": str(path), "opened": True})
        elif cmd == "send":
            if "\n" in args.prompt or "\r" in args.prompt:
                raise CliError("The shots command protocol accepts one-line prompts only.", hint="replace line breaks with spaces and retry")
            lines = [f"send {args.prompt}"]
            if not args.no_wait:
                lines.append(f"wait idle {int(args.timeout * 1000)}")
            data = dry_result(cmd, ["send prompt to scripted mock agent", "wait for the mock turn to finish" if not args.no_wait else "return without waiting"]) if args.dry_run else (driver.batch(lines, timeout=args.timeout + 10) and {"sent": True, "mock_only": True, "waited": not args.no_wait})
        elif cmd == "control":
            if any("\n" in value or "\r" in value for value in [args.verb, *args.argument]):
                raise CliError("Control commands cannot contain line breaks.")
            line = " ".join([args.verb, *args.argument]).strip()
            data = dry_result(cmd, [f"send {line!r} to isolated Trek"]) if args.dry_run else (driver.batch([line], timeout=args.timeout) and {"command_sent": line})
        elif cmd == "screenshot":
            name = safe_shot_name(args.name)
            output = args.output or (driver.home / "artifacts" / f"{name}.png")
            if not output.is_absolute():
                output = (root / output).resolve()
            actions = [f"render the isolated Trek window as {name}.png", f"write {output}"]
            if args.dry_run:
                data = dry_result(cmd, actions)
            else:
                data = driver.capture(name, output)
        elif cmd == "logs":
            if args.lines < 1:
                raise CliError("--lines must be at least 1.")
            text = tail_file(driver.log_path, args.lines)
            if args.grep:
                text = "\n".join(line for line in text.splitlines() if args.grep.lower() in line.lower())
            data = {"path": str(driver.log_path), "lines": text.splitlines(), "running": driver.status()["running"]}
        elif cmd == "check":
            checks = ["parse script/*.sh and script/lib/*.sh"]
            if not args.quick:
                checks.append("run CI-equivalent Rust workspace tests")
            checks.extend(["build trek-app with shots", "launch isolated mock-only Trek", "open and capture Basecamp", "open and capture General settings"])
            data = dry_result(cmd, checks) if args.dry_run else run_check(driver, quick=args.quick)
        elif cmd == "stop":
            data = dry_result(cmd, ["send quit to isolated Trek", "terminate only its process if it does not exit cleanly"]) if args.dry_run else driver.stop()
        elif cmd == "reset":
            if args.dry_run:
                data = dry_result(cmd, ["stop only the isolated Trek process", f"delete {driver.home}"])
            elif not args.yes:
                raise CliError("Reset needs explicit confirmation.", hint="inspect with reset --dry-run, then run reset --yes")
            else:
                data = driver.reset()
        else:
            raise CliError(f"Unhandled command: {cmd}")
        payload = {"ok": True, "command": cmd, **data}
        print(human(payload) if human_output else json.dumps(payload, indent=2))
        return 0
    except CliError as exc:
        payload = {"ok": False, "command": getattr(args, "command", None), "error": str(exc)}
        if exc.hint:
            payload["hint"] = exc.hint
        if exc.details:
            payload["details"] = exc.details
        print(human(payload) if human_output else json.dumps(payload, indent=2), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        payload = {"ok": False, "command": getattr(args, "command", None), "error": "Interrupted"}
        print(human(payload) if human_output else json.dumps(payload, indent=2), file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
